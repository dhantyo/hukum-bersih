---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Keep this page out of the search index. */
  noindex?: boolean;
  /** Which main section is current: "peraturan" | "ruu" | "tentang". */
  section?: string;
}
const { title, description, noindex = false, section } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { key: "peraturan", href: `${base}uu/`, label: "Peraturan" },
  { key: "ruu", href: `${base}ruu/`, label: "RUU" },
  { key: "tentang", href: `${base}tentang/`, label: "Tentang" },
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Beranda" ? "Hukum Bersih" : `${title} · Hukum Bersih`}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="skip" href="#main">Langsung ke isi</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={base}>Hukum Bersih</a>
        <nav aria-label="Utama">
          {nav.map((n) => (
            <a href={n.href} aria-current={section === n.key ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        <form class="search" action={`${base}cari/`} method="get" role="search">
          <label class="visually-hidden" for="q">Cari peraturan</label>
          <input id="q" name="q" type="search" placeholder="Cari undang-undang, pasal, kata…" autocomplete="off" />
        </form>
      </div>
    </header>
    <main id="main" class="wrap" data-pagefind-body={noindex ? undefined : true}>
      {!noindex && <span hidden data-pagefind-meta={`title:${title}`}></span>}
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          <strong>Hukum Bersih</strong> menyajikan teks peraturan dan rancangan undang-undang
          Indonesia apa adanya dari sumber resminya, dengan tautan ke berkas asli dan salinan
          arsipnya. Teks diambil otomatis dari PDF dan bisa memuat kesalahan baca; PDF resminya
          yang berlaku. Ini bukan nasihat hukum.
        </p>
        <p>
          Proyek terbuka: <a href="https://github.com/dhantyo/hukum-bersih">kode dan data di GitHub</a>
          · data CC0 · kode AGPL-3.0 · <a href={`${base}tentang/`}>tentang proyek ini</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; }
  .skip:focus { left: var(--s-4); top: var(--s-2); background: var(--bg); padding: var(--s-2); z-index: 10; }
  header.site { border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar { display: flex; align-items: center; gap: var(--s-5); min-height: 4rem; flex-wrap: wrap; }
  .brand { font-weight: 700; font-size: 1.125rem; color: var(--text); text-decoration: none; letter-spacing: -0.01em; }
  nav { display: flex; gap: var(--s-4); }
  nav a { color: var(--text); text-decoration: none; font-weight: 500; padding: var(--s-1) 0; border-bottom: 2px solid transparent; }
  nav a:hover { border-bottom-color: var(--line); }
  nav a[aria-current="page"] { border-bottom-color: var(--primary); color: var(--primary); }
  .search { margin-left: auto; flex: 0 1 20rem; }
  .search input {
    width: 100%; font: inherit; font-size: var(--fs-sm); color: var(--text);
    background: var(--bg-subtle); border: 1px solid var(--line); border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
  }
  .search input:focus { background: var(--bg); }
  footer.site { margin-top: var(--s-8); border-top: 1px solid var(--line); background: var(--bg-subtle); }
  footer.site .wrap { padding-top: var(--s-6); padding-bottom: var(--s-7); max-width: var(--page); }
  footer.site p { font-size: var(--fs-sm); color: var(--text-muted); max-width: var(--measure); }
  @media (max-width: 640px) {
    .bar { gap: var(--s-3); padding-top: var(--s-3); padding-bottom: var(--s-3); }
    .search { flex-basis: 100%; margin-left: 0; }
  }
</style>
