---
interface Props {
  title: string;
  /** Keep this page out of the search index. */
  noindex?: boolean;
}
const { title, noindex = false } = Astro.props;
const home = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Hukum Bersih</title>
  </head>
  <body>
    <header><a href={home}>Hukum Bersih</a></header>
    <main data-pagefind-body={noindex ? undefined : true}>
      <slot />
    </main>
  </body>
</html>
