---
import "../styles/global.css";
import ReadingSettings, { type LawView } from "../components/ReadingSettings.astro";

interface Props {
  title: string;
  description?: string;
  /** Keep this page out of the search index. */
  noindex?: boolean;
  /** Which main section is current: "peraturan" | "ruu" | "tentang". */
  section?: string;
  /** Show the search field in the header (off on the home page, which has its own). */
  search?: boolean;
  /** A page with a law text: the "Aa" settings also offer its view (decision 0009). */
  view?: LawView;
}
const { title, description, noindex = false, section, search = true, view } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { key: "peraturan", href: `${base}uu/`, label: "Peraturan" },
  { key: "koleksi", href: `${base}koleksi/`, label: "Koleksi" },
  { key: "ruu", href: `${base}ruu/`, label: "RUU" },
  { key: "tentang", href: `${base}tentang/`, label: "Tentang" },
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Beranda" ? "Hukum Bersih" : `${title} · Hukum Bersih`}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // reader's font / size for law text (components/ReadingSettings.astro), before first paint
      try {
        var fa = localStorage.getItem("hb-font-asli"), fm = localStorage.getItem("hb-font-modern"), z = localStorage.getItem("hb-size");
        if (fa && fa !== "serif") document.documentElement.dataset.fontAsli = fa;
        if (fm && fm !== "atkinson") document.documentElement.dataset.fontModern = fm;
        if (z && z !== "normal") document.documentElement.dataset.size = z;
      } catch (e) {}
      // side panel of document pages hidden on wide screens (components/DocLayout.astro)
      try { if (localStorage.getItem("hb-panel") === "hidden") document.documentElement.dataset.panel = "hidden"; } catch (e) {}
      // reader's view of law texts (components/ReadingSettings.astro): format, Penjelasan, parts
      try {
        var v = JSON.parse(localStorage.getItem("hb-view") || "{}"), d = document.documentElement.dataset;
        d.format = v.format === "asli" ? "asli" : "modern";
        d.penjelasan = v.penjelasan === "pasal" || v.penjelasan === "sembunyi" ? v.penjelasan : "akhir";
        if (v.cj === false) d.cj = "hide";
        if (Array.isArray(v.hide) && v.hide.length) d.hide = v.hide.join(" ");
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Langsung ke isi</a>
    <div class="site-slot">
    <header class="site">
      <div class={`wrap bar${search ? "" : " no-search"}`}>
        <a class="brand" href={base}>Hukum Bersih</a>
        <nav aria-label="Utama">
          {nav.map((n) => (
            <a href={n.href} aria-current={section === n.key ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
        {search && (
          <form class="search" action={`${base}cari/`} method="get" role="search">
            <label class="visually-hidden" for="q">Cari peraturan</label>
            <input id="q" name="q" type="search" placeholder="Cari undang-undang, pasal, kata…" autocomplete="off" />
          </form>
        )}
        <ReadingSettings view={view} />
      </div>
    </header>
    </div>
    <main id="main" class="wrap" data-pagefind-body={noindex ? undefined : true}>
      {!noindex && <span hidden data-pagefind-meta={`title:${title}`}></span>}
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          <strong>Hukum Bersih</strong> menyajikan teks peraturan dan rancangan undang-undang
          Indonesia apa adanya dari sumber resminya, dengan tautan ke berkas asli dan salinan
          arsipnya. Teks diambil otomatis dari PDF dan bisa memuat kesalahan baca; PDF resminya
          yang berlaku. Ini bukan nasihat hukum.
        </p>
        <p>
          Proyek terbuka: <a href="https://github.com/dhantyo/hukum-bersih">kode dan data di GitHub</a>{" "}
          · data CC0 · kode AGPL-3.0 · <a href={`${base}tentang/`}>tentang proyek ini</a>
        </p>
      </div>
    </footer>
    <script>
      // The header follows the scroll like a phone browser's address bar (lib/barscroll.ts, as in
      // Sapu Berita). The browser moves it, like the text: script only switches it between in the
      // page ("free"), pinned to the top and hidden above, so it never lags the page. It stays
      // while "Aa" is open or focus is inside it, and tucks away after a jump within the page.
      // [data-under-header] elements (sticky panel, comparison bar) get --header-shown: the
      // header's height while it is pinned, else 0.
      import { settledBarOffset, shownPx, step, type HeaderState } from "../lib/barscroll.ts";
      const root = document.documentElement;
      const header = document.querySelector<HTMLElement>("header.site");
      const slot = header?.parentElement;
      if (header && slot) {
        let s: HeaderState = { mode: "free", y: 0 };
        let lastTop = Math.max(0, scrollY), dir = 0, frame = 0, h = header.offsetHeight, under = -1;
        let settle: ReturnType<typeof setTimeout> | undefined;
        const maxTop = () => root.scrollHeight - innerHeight;
        const held = () => !!header.querySelector("details[open]") || header.contains(document.activeElement);
        const setUnder = () => {
          const px = s.mode === "pinned" ? h : 0;
          if (px === under) return;
          under = px;
          document.querySelectorAll<HTMLElement>("[data-under-header]").forEach((e) => e.style.setProperty("--header-shown", `${px}px`));
        };
        /** draw the state; `from` (px pushed up) slides a fixed header from there to its place */
        const draw = (from?: number) => {
          header.dataset.mode = s.mode;
          header.style.top = s.mode === "free" ? `${s.y}px` : "";
          header.toggleAttribute("data-hidden", s.mode === "hidden");
          if (from !== undefined && s.mode !== "free") {
            header.style.transition = "none";
            header.style.transform = `translateY(${-from}px)`;
            header.offsetHeight;   // start the slide from there
            header.style.removeProperty("transition");
          }
          header.style.transform = s.mode === "hidden" ? `translateY(${-h}px)` : "";
          setUnder();
        };
        const to = (mode: "pinned" | "hidden") => {
          const from = h - shownPx(s, lastTop, h);
          s = { mode } as HeaderState;
          draw(from);
        };
        const follow = () => {
          frame = 0;
          // the rubber band past either end of the page is not a scroll
          const top = Math.min(Math.max(0, scrollY), Math.max(0, maxTop()));
          if (top === lastTop) return;
          dir = Math.sign(top - lastTop);
          if (held()) { lastTop = top; if (s.mode !== "pinned") to("pinned"); return; }
          const next = step(s, lastTop, top, h);
          lastTop = top;
          if (next.mode !== s.mode || (next.mode === "free" && s.mode === "free" && next.y !== s.y)) { s = next; draw(); }
          clearTimeout(settle);
          settle = setTimeout(() => {
            if (s.mode !== "free") return;
            const shown = shownPx(s, lastTop, h);
            if (shown === 0 || (shown === h && lastTop === s.y)) return;
            if (lastTop <= h && s.y === 0) return;   // the top of the page: it is just in its place
            to(settledBarOffset(h - shown, lastTop, h, dir) === 0 ? "pinned" : "hidden");
          }, 140);
        };
        addEventListener("scroll", () => { if (!frame) frame = requestAnimationFrame(follow); }, { passive: true });
        header.addEventListener("focusin", () => { if (s.mode !== "pinned" && lastTop > 0) to("pinned"); });
        header.addEventListener("toggle", () => { if (s.mode !== "pinned" && lastTop > 0) to("pinned"); }, true);
        // a jump within the page (contents, "#" links): out of the way of what was jumped to
        addEventListener("hashchange", () => requestAnimationFrame(() => {
          lastTop = Math.max(0, scrollY);
          if (lastTop > h) to("hidden");
        }));
        // keep the header's place in the page as tall as the header
        new ResizeObserver(() => {
          h = header.offsetHeight;
          slot.style.height = `${h}px`;
          under = -1; setUnder();
        }).observe(header);
        slot.style.height = `${h}px`;
        root.classList.add("hb-follow");
        draw();
      }
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; }
  .skip:focus { left: var(--s-4); top: var(--s-2); background: var(--bg); padding: var(--s-2); z-index: 10; }
  header.site { border-bottom: 1px solid var(--line); background: var(--bg); }
  /* following the scroll (script below; without it the header just sits in the page): the slot
     keeps its place, the header is either in the page at a script-set position ("free"), or
     fixed at the top of the window, slid out of it when hidden */
  :global(.hb-follow) header.site { position: absolute; left: 0; right: 0; top: 0; z-index: 15; }
  :global(.hb-follow) header.site:is([data-mode="pinned"], [data-mode="hidden"]) {
    position: fixed; transition: transform 0.24s ease-out;
  }
  /* fully away: out of the tab order too, once the slide has finished */
  header.site[data-hidden] { visibility: hidden; transition: transform 0.24s ease-out, visibility 0s 0.24s; }
  @media (prefers-reduced-motion: reduce) { header.site, header.site[data-hidden] { transition: none !important; } }
  .bar { display: flex; align-items: center; gap: var(--s-5); min-height: 4rem; flex-wrap: wrap; }
  .brand { font-weight: 700; font-size: var(--fs-lg); color: var(--text); text-decoration: none; letter-spacing: -0.01em; }
  nav { display: flex; gap: var(--s-4); }
  nav a { color: var(--text); text-decoration: none; font-weight: 500; padding: var(--s-1) 0; border-bottom: 2px solid transparent; }
  nav a:hover { border-bottom-color: var(--line); }
  nav a[aria-current="page"] { border-bottom-color: var(--primary); color: var(--primary); }
  .search { margin-left: auto; flex: 0 1 20rem; }
  /* no search field (home page): the reading settings move to the right edge */
  .no-search :global(.reading) { margin-left: auto; }
  .bar { column-gap: var(--s-3); }
  nav { margin-right: var(--s-3); }
  .search input {
    width: 100%; font: inherit; font-size: var(--fs-sm); color: var(--text);
    background: var(--bg-subtle); border: 1px solid var(--line-strong); border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
  }
  .search input:focus { background: var(--bg); }
  footer.site { margin-top: var(--s-8); border-top: 1px solid var(--line); background: var(--bg-subtle); }
  footer.site .wrap { padding-top: var(--s-6); padding-bottom: var(--s-7); max-width: var(--page); }
  footer.site p { font-size: var(--fs-sm); color: var(--text-muted); max-width: var(--measure); }
  /* tablets and phones: the search field takes its own full row, with "Aa" beside it */
  @media (max-width: 960px) {
    .bar { row-gap: var(--s-3); padding-top: var(--s-3); padding-bottom: var(--s-3); }
    .search { flex: 1 1 calc(100% - 4rem); margin-left: 0; order: 3; }
    .bar :global(.reading) { order: 4; }
  }
  @media (max-width: 640px) {
    .bar { gap: var(--s-2) var(--s-3); }
    .brand { flex-basis: 100%; }
  }
</style>
