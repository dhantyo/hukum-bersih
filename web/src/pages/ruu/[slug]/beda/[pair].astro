---
import Base from "../../../../layouts/Base.astro";
import { compare, type Comparison } from "../../../../lib/compare.ts";
import { loadRuus, loadText, versions, type Ruu, type RuuDocument } from "../../../../lib/data.ts";
import { DOC_TYPE, PROVENANCE, provenanceKey, STATUS, tanggal } from "../../../../lib/labels.ts";

export function getStaticPaths() {
  return loadRuus().flatMap((ruu) => {
    const v = versions(ruu);
    return v.flatMap((a, i) => v.slice(i + 1).map((b) => ({
      params: { slug: ruu.slug, pair: `${a.id}...${b.id}` },
      props: { ruu, a, b },
    })));
  });
}
const { ruu, a, b } = Astro.props as { ruu: Ruu; a: RuuDocument; b: RuuDocument };
const base = import.meta.env.BASE_URL;
const cmp: Comparison = compare(loadText(ruu, a), loadText(ruu, b));
const name = (d: RuuDocument) => `${DOC_TYPE[d.type] ?? d.type} (${tanggal(d.date)})`;
const prov = (d: RuuDocument) => PROVENANCE[provenanceKey(d.provenance)];
const yearOf = (d: RuuDocument) => d.date.slice(0, 4);
/** Row anchor for each pasal, so cross-references can link to where it is shown. */
const anchorOf = new Map(cmp.rows.flatMap((r) => {
  const anchor = r.b ? `b-${r.b.eId}` : `a-${r.a!.eId}`;
  return [r.a, r.b].filter(Boolean).map((p) => [p!, anchor] as const);
}));
/** Matches below this are shown with a "low similarity" note. */
const WEAK = 0.34;
/** BAB dividers follow the new version; removed pasal stay under the current BAB. */
let chapter: string | undefined;
const chapterChange = (r: (typeof cmp.rows)[number]) => {
  if (!r.b?.chapter || r.b.chapter === chapter) return undefined;
  chapter = r.b.chapter;
  return chapter;
};
---
<Base title={`${ruu.short_name ?? ruu.title}: perbandingan`} noindex section="ruu">
  <nav class="breadcrumbs" aria-label="Lokasi"><a href={`${base}ruu/`}>RUU</a><span aria-hidden="true">›</span><a href={`${base}ruu/${ruu.slug}/`}>{ruu.short_name ?? ruu.title}</a><span aria-hidden="true">›</span><span>Perbandingan</span></nav>
  <h1>Apa yang berubah?</h1>
  <div class="versions">
    {[a, b].map((d, k) => (
      <div class="card small">
        <div class="muted">{k === 0 ? "Dari" : "Menjadi"}</div>
        <a href={`${base}ruu/${ruu.slug}/${d.id}/`}><strong>{name(d)}</strong></a>
        <div><span class={`badge ${provenanceKey(d.provenance)}`}>{prov(d).label}</span></div>
      </div>
    ))}
  </div>

  <div class="summary card small">
    <span><strong>{cmp.counts.berubah}</strong> pasal berubah</span>
    <span><strong>{cmp.counts.baru}</strong> pasal baru</span>
    <span><strong>{cmp.counts.dihapus}</strong> pasal dihapus</span>
    <span><strong>{cmp.counts.sama}</strong> tidak berubah</span>
    <div class="muted">
      Nomor pasal bergeser antarversi, jadi pasal dicocokkan berdasarkan isinya, bukan nomornya.
      {cmp.counts.renumbered > 0 && ` ${cmp.counts.renumbered} pasal berganti nomor.`}
      {" "}Pencocokan dilakukan otomatis; periksa teks lengkapnya untuk kepastian.
    </div>
    <label class="toggle"><input type="checkbox" id="show-same" /> Tampilkan juga pasal yang isi dan nomornya tidak berubah</label>
  </div>

  <!-- Synopsis layout (as in German "Synopse", EU four-column documents, Indonesian DIM):
       one row per matched pasal, old left, new right, ayat aligned within the row. -->
  <div id="rows" class="synopsis hide-same">
    <div class="syn-head">
      <div>{name(a)}</div>
      <div>{name(b)}</div>
    </div>
    {cmp.rows.map((r) => {
      const anchor = r.b ? `b-${r.b.eId}` : `a-${r.a!.eId}`;
      const newChapter = chapterChange(r);
      return (
        <>
          {newChapter && <div class="syn-chapter">{newChapter}</div>}
          <section class={`syn-row ${r.status}${r.renumbered ? " renumbered" : ""}`} id={anchor}>
            <div class="syn-meta">
              <a href={`#${anchor}`}>{STATUS[r.status]}</a>
              {r.moved && <span class="tag">dipindah</span>}
              {r.status === "sama" && r.renumbered && <span class="tag">nomor berubah</span>}
              {r.a && r.b && r.status === "berubah" && r.similarity < WEAK && (
                <span class="tag" title="Dicocokkan otomatis berdasarkan isi; kemiripannya rendah, periksa kedua teks.">kemiripan rendah</span>
              )}
            </div>
            <div class="syn-pair">
              <div class="cell old">
                {r.a ? <h3>{r.a.label} <span class="ver">{yearOf(a)}</span></h3> : <p class="none">Tidak ada pada versi ini</p>}
              </div>
              <div class="cell new">
                {r.b ? <h3>{r.b.label} <span class="ver">{yearOf(b)}</span></h3> : <p class="none">Dihapus</p>}
              </div>
              {r.lines.map((l) => {
                // a reworded ayat ("diganti") shows old left and new right on the same row
                const oldKind = l.kind === "diganti" ? "dihapus" : l.kind;
                const newKind = l.kind === "diganti" ? "baru" : l.kind;
                const ref = l.ref && (
                  <span class="ref">≈ <a href={`#${anchorOf.get(l.ref.pasal) ?? ""}`}>{l.ref.label}</a> ({yearOf(l.ref.side === "a" ? a : b)})</span>
                );
                const any = l.b ?? l.a!;
                const numChanged = l.a && l.b && l.a.num !== l.b.num;
                return (
                  <>
                    <div class={`cell old line ${oldKind}`} style={`--i:${l.a?.indent ?? any.indent}`}>
                      {l.a && <span class="num">{numChanged ? <del>{l.a.num}</del> : l.a.num}</span>}
                      <span class="txt">
                        {oldKind !== "baru" && l.parts.filter((p) => !p.added).map((p) =>
                          p.removed ? <del>{p.value}</del> : p.value)}
                        {l.kind === "dihapus" && ref}
                      </span>
                    </div>
                    <div class={`cell new line ${newKind}`} style={`--i:${l.b?.indent ?? any.indent}`}>
                      {l.b && <span class="num">{numChanged ? <ins>{l.b.num}</ins> : l.b.num}</span>}
                      <span class="txt">
                        {newKind !== "dihapus" && l.parts.filter((p) => !p.removed).map((p) =>
                          p.added ? <ins>{p.value}</ins> : p.value)}
                        {l.kind === "baru" && ref}
                      </span>
                    </div>
                    <div class={`cell inline line ${l.kind}`} style={`--i:${any.indent}`}>
                      <span class="num">{numChanged ? <><del>{l.a!.num}</del> <ins>{l.b!.num}</ins></> : any.num}</span>
                      <span class="txt">
                        {l.kind === "diganti"
                          ? <><del>{l.parts[0].value}</del><br /><ins>{l.parts[1].value}</ins></>
                          : l.parts.map((p) => p.added ? <ins>{p.value}</ins> : p.removed ? <del>{p.value}</del> : p.value)}
                        {ref}
                      </span>
                    </div>
                  </>
                );
              })}
            </div>
          </section>
        </>
      );
    })}
  </div>
</Base>

<script>
  const box = document.getElementById("show-same") as HTMLInputElement | null;
  const rows = document.getElementById("rows");
  box?.addEventListener("change", () => rows?.classList.toggle("hide-same", !box.checked));
</script>

<style>
  .versions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .summary span { display: inline-block; margin-right: 1rem; white-space: nowrap; }
  .summary .muted { margin-top: 0.4rem; }
  .toggle { display: block; margin-top: 0.6rem; cursor: pointer; }

  .synopsis { margin-top: 1.5rem; }
  .syn-head, .syn-pair { display: grid; grid-template-columns: 1fr 1fr; column-gap: 1.5rem; }
  .syn-head {
    position: sticky; top: 0; z-index: 1; background: var(--bg); padding: 0.6rem 0;
    border-bottom: 2px solid var(--line); font-weight: 700; font-size: 0.9rem;
  }
  .syn-chapter {
    margin: 2rem 0 0.25rem; padding: 0.35rem 0; font-weight: 700; font-size: 0.85rem;
    letter-spacing: 0.04em; color: var(--text-muted); border-bottom: 1px solid var(--line);
  }
  /* hide only pasal whose text and number are both unchanged */
  .hide-same .syn-row.sama:not(.renumbered) { display: none; }
  .syn-row { padding: 0.75rem 0 1rem; border-bottom: 1px solid var(--line); scroll-margin-top: 3rem; }
  .syn-meta { display: flex; gap: 0.5rem; align-items: center; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.25rem; }
  .syn-meta a { text-decoration: none; padding: 0 var(--s-2); border-radius: 999px; border: 1px solid currentColor; color: var(--text-muted); }
  .berubah .syn-meta a { background: transparent; color: var(--warn); border: 1px solid currentColor; }
  .baru .syn-meta a { color: var(--ok); }
  .dihapus .syn-meta a { color: var(--del-text); }
  .syn-meta .tag { color: var(--text-muted); font-weight: 500; }
  .cell h3 { font-size: 0.95rem; margin: 0.25rem 0 0.4rem; }
  .cell h3 .ver { font-weight: 400; color: var(--text-muted); font-size: 0.85em; }
  .cell .none { color: var(--text-muted); font-style: italic; font-size: 0.9rem; margin: 0.25rem 0; }
  /* hanging numbers: "(1)" / "a." in their own column, wrapped text stays indented; each
     nesting level (--i) indents by one number column */
  .cell.line {
    --num: 2.3rem;
    display: grid; grid-template-columns: minmax(var(--num), max-content) 1fr; column-gap: 0.3rem;
    align-items: start;
    margin: 0.1rem 0 0.1rem calc(var(--i, 0) * var(--num));
    padding: 0.2rem 0.4rem; border-radius: 4px;
  }
  .cell.line .num { grid-column: 1; white-space: nowrap; }
  .cell.line .txt { grid-column: 2; min-width: 0; }
  .cell.line { font-family: var(--font-law); font-size: var(--fs-law); line-height: 1.6; }
  .cell.line .num:empty + .txt { grid-column: 1 / -1; }
  .cell.old.line.dihapus { background: var(--del-bg); color: var(--del-text); }
  .cell.new.line.baru { background: var(--ins-bg); color: var(--ins-text); }
  .cell.new.line.dihapus, .cell.old.line.baru { visibility: hidden; padding-top: 0; padding-bottom: 0; }
  .cell.inline { display: none; }
  /* inline-block: a struck-through line's strike does not carry into its pointer */
  .ref { display: inline-block; width: 100%; margin-top: 0.2rem; font-size: 0.8rem; color: var(--text-muted); }
  .ref a { color: inherit; }
  .cell.old.line.dihapus del { background: none; }
  .cell.new.line.baru ins { background: none; }
  .dihapus .cell.new, .baru .cell.old { color: var(--text-muted); }

  @media (max-width: 760px) {
    /* phones: one inline column (deletions and insertions marked in place), like most diff tools */
    .versions { grid-template-columns: 1fr; }
    .syn-head { display: none; }
    .syn-pair { grid-template-columns: 1fr; }
    .cell.line.old, .cell.line.new { display: none; }
    .cell.inline { display: grid; }
    .cell.inline.dihapus { background: var(--del-bg); color: var(--del-text); }
    .cell.inline.dihapus .txt > :not(.ref), .cell.inline.dihapus .num { text-decoration: line-through; }
    .cell.inline.baru { background: var(--ins-bg); color: var(--ins-text); }
    .cell.inline.dihapus del, .cell.inline.baru ins { background: none; }
    .baru .cell.old:not(.line), .dihapus .cell.new:not(.line) { display: none; }
    .cell.line { --num: 1.9rem; }
  }
</style>
