---
import Base from "../../../../layouts/Base.astro";
import { compare, type Comparison } from "../../../../lib/compare.ts";
import { loadRuus, loadText, versions, type Ruu, type RuuDocument } from "../../../../lib/data.ts";
import { DOC_TYPE, PROVENANCE, provenanceKey, STATUS, tanggal } from "../../../../lib/labels.ts";

export function getStaticPaths() {
  return loadRuus().flatMap((ruu) => {
    const v = versions(ruu);
    return v.flatMap((a, i) => v.slice(i + 1).map((b) => ({
      params: { slug: ruu.slug, pair: `${a.id}...${b.id}` },
      props: { ruu, a, b },
    })));
  });
}
const { ruu, a, b } = Astro.props as { ruu: Ruu; a: RuuDocument; b: RuuDocument };
const base = import.meta.env.BASE_URL;
const cmp: Comparison = compare(loadText(ruu, a), loadText(ruu, b));
const name = (d: RuuDocument) => `${DOC_TYPE[d.type] ?? d.type} (${tanggal(d.date)})`;
const prov = (d: RuuDocument) => PROVENANCE[provenanceKey(d.provenance)];
const yearOf = (d: RuuDocument) => d.date.slice(0, 4);
/** Matches below this are shown with a "low similarity" note. */
const WEAK = 0.4;
---
<Base title={`${ruu.short_name ?? ruu.title}: perbandingan`} noindex>
  <p class="muted small"><a href={`${base}ruu/`}>RUU</a> › <a href={`${base}ruu/${ruu.slug}/`}>{ruu.short_name ?? ruu.title}</a></p>
  <h1>Apa yang berubah?</h1>
  <div class="versions">
    {[a, b].map((d, k) => (
      <div class="card small">
        <div class="muted">{k === 0 ? "Dari" : "Menjadi"}</div>
        <a href={`${base}ruu/${ruu.slug}/${d.id}/`}><strong>{name(d)}</strong></a>
        <div><span class={`badge ${provenanceKey(d.provenance)}`}>{prov(d).label}</span></div>
      </div>
    ))}
  </div>

  <div class="summary card small">
    <span><strong>{cmp.counts.berubah}</strong> pasal berubah</span>
    <span><strong>{cmp.counts.baru}</strong> pasal baru</span>
    <span><strong>{cmp.counts.dihapus}</strong> pasal dihapus</span>
    <span><strong>{cmp.counts.sama}</strong> tidak berubah</span>
    <div class="muted">
      Nomor pasal bergeser antarversi, jadi pasal dicocokkan berdasarkan isinya, bukan nomornya.
      {cmp.counts.renumbered > 0 && <> {cmp.counts.renumbered} pasal berganti nomor.</>}
      Pencocokan dilakukan otomatis; periksa teks lengkapnya untuk kepastian.
    </div>
    <label class="toggle"><input type="checkbox" id="show-same" /> Tampilkan juga pasal yang tidak berubah</label>
  </div>

  <div id="rows" class="hide-same">
    {cmp.rows.map((r) => {
      const anchor = r.b ? `b-${r.b.eId}` : `a-${r.a!.eId}`;
      return (
        <section class={`row ${r.status}`} id={anchor}>
          <h3>
            <a href={`#${anchor}`}>
              {r.a && r.b && r.renumbered
                ? <>{r.a.label} <span class="ver">({yearOf(a)})</span> → {r.b.label} <span class="ver">({yearOf(b)})</span></>
                : r.a && !r.b ? <>{r.a.label} <span class="ver">({yearOf(a)})</span></>
                : r.b && !r.a ? <>{r.b.label} <span class="ver">({yearOf(b)})</span></>
                : r.b!.label}
            </a>
            <span class={`status ${r.status}`}>{STATUS[r.status]}</span>
            {r.moved && <span class="status moved">Dipindah</span>}
            {r.a && r.b && r.status === "berubah" && r.similarity < WEAK && (
              <span class="status moved" title="Dicocokkan otomatis berdasarkan isi; kemiripannya rendah, periksa kedua teks.">Kemiripan rendah</span>
            )}
          </h3>
          {r.lines.map((l) => (
            <p class={`l i${l.indent} ${l.kind}`}>
              {l.parts.map((p) => p.added ? <ins>{p.value}</ins> : p.removed ? <del>{p.value}</del> : p.value)}
            </p>
          ))}
        </section>
      );
    })}
  </div>
</Base>

<script>
  const box = document.getElementById("show-same") as HTMLInputElement | null;
  const rows = document.getElementById("rows");
  box?.addEventListener("change", () => rows?.classList.toggle("hide-same", !box.checked));
</script>

<style>
  .versions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .summary span { display: inline-block; margin-right: 1rem; white-space: nowrap; }
  .summary .muted { margin-top: 0.4rem; }
  .toggle { display: block; margin-top: 0.6rem; cursor: pointer; }
  .hide-same .row.sama { display: none; }
  .row { border-top: 1px solid var(--line); padding: 0.5rem 0 1rem; }
  .row h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 1rem 0 0.5rem; }
  .row h3 a { color: inherit; text-decoration: none; }
  .row h3 .ver { font-weight: 400; color: var(--muted); font-size: 0.85em; }
  .status { font-size: 0.75rem; font-weight: 600; padding: 0.05rem 0.5rem; border-radius: 999px;
    background: var(--line); color: var(--text); }
  .status.berubah { background: #f3e3b5; color: #5b4300; }
  .status.baru { background: var(--ins-bg); color: var(--ins-text); }
  .status.dihapus { background: var(--del-bg); color: var(--del-text); }
  .status.moved { background: transparent; border: 1px solid var(--line); color: var(--muted); }
  p.l { margin: 0.3rem 0; }
  p.l.baru { background: var(--ins-bg); color: var(--ins-text); }
  p.l.dihapus { background: var(--del-bg); color: var(--del-text); text-decoration: line-through; }
  p.l.baru ins, p.l.dihapus del { background: none; }
  p.i1 { margin-left: 1.5rem; }
  p.i2 { margin-left: 3rem; }
  p.i3 { margin-left: 4.5rem; }
  @media (max-width: 480px) {
    .versions { grid-template-columns: 1fr; }
    p.i1 { margin-left: 0.9rem; } p.i2 { margin-left: 1.8rem; } p.i3 { margin-left: 2.7rem; }
  }
</style>
