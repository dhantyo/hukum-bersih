---
import Base from "../../../layouts/Base.astro";
import DocLayout from "../../../components/DocLayout.astro";
import Facts from "../../../components/Facts.astro";
import { loadRuus, versions, type Ruu } from "../../../lib/data.ts";
import { DOC_TYPE, PROVENANCE, provenanceKey, STAGE, tanggal } from "../../../lib/labels.ts";

export function getStaticPaths() {
  return loadRuus().map((ruu) => ({ params: { slug: ruu.slug }, props: { ruu } }));
}
const { ruu } = Astro.props as { ruu: Ruu };
const base = import.meta.env.BASE_URL;
const texts = versions(ruu);
const docs = [...ruu.documents].sort((a, b) => b.date.localeCompare(a.date));
const oldest = texts[0];
const newest = texts.at(-1);
const last = ruu.stages.at(-1);
---
<Base title={ruu.short_name ?? ruu.title} description={ruu.title} section="ruu">
  <DocLayout
    crumbs={[{ href: `${base}ruu/`, label: "RUU" }, { label: ruu.short_name ?? ruu.title }]}
    eyebrow="Rancangan Undang-Undang"
    title={ruu.short_name ?? ruu.title}
    subtitle={ruu.title}
    panelLabel="Keterangan"
  >
    <div slot="head" class="head-meta">
      {ruu.enacted_as ? <span class="badge berlaku">Disahkan</span> : <span class="badge warn">Belum diundangkan</span>}
      {last && <span class="muted small">Tahap terakhir: {STAGE[last.stage] ?? last.stage}, {tanggal(last.date)}</span>}
    </div>
    <Fragment slot="panel">
      <Facts title="Keterangan" facts={[
        { label: "Pengusul", value: ruu.initiator },
        { label: "Judul sebelumnya", value: ruu.former_titles?.join("; ") },
        { label: "Disahkan sebagai", value: ruu.enacted_as },
        { label: "Versi teks", value: `${texts.length} dari ${ruu.documents.length} dokumen yang diketahui` },
        { label: "Halaman DPR", value: ruu.dpr_page ? "dpr.go.id" : null, href: ruu.dpr_page },
      ]} />
    </Fragment>

    {oldest && newest && oldest !== newest && (
      <a class="compare" href={`${base}ruu/${ruu.slug}/beda/${oldest.id}...${newest.id}/`}>
        <span class="compare-label">Apa yang berubah?</span>
        <span>{DOC_TYPE[oldest.type] ?? oldest.type} ({tanggal(oldest.date)}) → {DOC_TYPE[newest.type] ?? newest.type} ({tanggal(newest.date)}), pasal demi pasal</span>
      </a>
    )}

    <h2>Perjalanan</h2>
    <ol class="timeline">
      {ruu.stages.map((s) => (
        <li>
          <time class="muted small">{tanggal(s.date)}</time>
          <div><strong>{STAGE[s.stage] ?? s.stage}</strong>{s.note && <span class="muted"> · {s.note}</span>}</div>
        </li>
      ))}
    </ol>

    <h2>Dokumen dan versi</h2>
    <p class="muted small">
      Asal: <span class="badge official">Resmi</span> dari situs lembaga negara,
      <span class="badge archive">Arsip</span> dari arsip web,
      <span class="badge media">Media</span> dari pemberitaan,
      <span class="badge none">Belum ditemukan</span> diketahui ada tetapi berkasnya belum ditemukan (tidak pernah direka ulang).
    </p>
    <ul class="rows">
      {docs.map((d) => {
        const p = PROVENANCE[provenanceKey(d.provenance)];
        return (
          <li id={d.id}>
            <div class="row-title">
              {d.text ? <a href={`${base}ruu/${ruu.slug}/${d.id}/`}>{DOC_TYPE[d.type] ?? d.type}</a> : DOC_TYPE[d.type] ?? d.type}
              <span class="muted"> · {tanggal(d.date)}</span>
              {" "}<span class={`badge ${provenanceKey(d.provenance)}`} title={p.hint}>{p.label}</span>
            </div>
            {d.label && <div class="small">{d.label}</div>}
            {d.note && <div class="row-meta">{d.note}</div>}
            {(d.source_url || d.archive_url) && (
              <div class="row-meta links">
                {d.text && <a href={`${base}ruu/${ruu.slug}/${d.id}/`}>Baca teks</a>}
                {d.source_url && <a href={d.source_url}>Sumber{d.obtained_by ? ` (${d.obtained_by})` : ""}</a>}
                {d.archive_url && <a href={d.archive_url}>PDF arsip</a>}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </DocLayout>
</Base>

<style>
  .head-meta { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); align-items: center; }
  .compare {
    display: block; padding: var(--s-4) var(--s-5); border: 1px solid var(--primary); border-radius: var(--r-md);
    background: var(--primary-bg); color: var(--text); text-decoration: none; max-width: var(--measure);
  }
  .compare:hover { border-width: 2px; padding: calc(var(--s-4) - 1px) calc(var(--s-5) - 1px); }
  .compare-label { display: block; font-weight: 600; color: var(--primary); }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 var(--s-5); border-left: 2px solid var(--line); max-width: var(--measure); }
  .timeline li { position: relative; padding-bottom: var(--s-4); }
  .timeline li::before {
    content: ""; position: absolute; left: calc(-1 * var(--s-5) - 7px); top: 0.35rem; width: 12px; height: 12px;
    border-radius: 50%; background: var(--bg); border: 2px solid var(--primary);
  }
  .timeline li:last-child::before { background: var(--primary); }
  .links { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); }
  .rows { max-width: var(--measure); }
</style>
