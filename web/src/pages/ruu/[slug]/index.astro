---
import Base from "../../../layouts/Base.astro";
import { loadRuus, versions, type Ruu } from "../../../lib/data.ts";
import { DOC_TYPE, PROVENANCE, provenanceKey, STAGE, tanggal } from "../../../lib/labels.ts";

export function getStaticPaths() {
  return loadRuus().map((ruu) => ({ params: { slug: ruu.slug }, props: { ruu } }));
}
const { ruu } = Astro.props as { ruu: Ruu };
const base = import.meta.env.BASE_URL;
const texts = versions(ruu);
const docs = [...ruu.documents].sort((a, b) => b.date.localeCompare(a.date));
const oldest = texts[0];
const newest = texts.at(-1);
---
<Base title={ruu.short_name ?? ruu.title} description={ruu.title}>
  <p class="muted small"><a href={`${base}ruu/`}>RUU</a></p>
  <h1>{ruu.short_name ?? ruu.title}</h1>
  <p>{ruu.title}</p>
  {ruu.former_titles?.length ? (
    <p class="muted small">Judul sebelumnya: {ruu.former_titles.join("; ")}</p>
  ) : null}
  <p class="small">
    {ruu.enacted_as ? <>Telah disahkan sebagai <strong>{ruu.enacted_as}</strong>.</>
      : <>Belum diundangkan.</>}
    {ruu.dpr_page && <> · <a href={ruu.dpr_page}>Halaman DPR</a></>}
  </p>

  {oldest && newest && oldest !== newest && (
    <p class="card">
      <strong>Apa yang berubah?</strong><br />
      <a href={`${base}ruu/${ruu.slug}/beda/${oldest.id}...${newest.id}/`}>
        Bandingkan {DOC_TYPE[oldest.type] ?? oldest.type} ({tanggal(oldest.date)}) dengan
        {" "}{DOC_TYPE[newest.type] ?? newest.type} ({tanggal(newest.date)}), pasal demi pasal
      </a>
    </p>
  )}

  <h2>Perjalanan</h2>
  <ol class="timeline">
    {ruu.stages.map((s) => (
      <li>
        <span class="muted small">{tanggal(s.date)}</span><br />
        <strong>{STAGE[s.stage] ?? s.stage}</strong>{s.note && <span> · {s.note}</span>}
      </li>
    ))}
  </ol>

  <h2>Dokumen dan versi</h2>
  <p class="muted small">
    Label asal: <strong>Resmi</strong> dari situs lembaga negara, <strong>Arsip</strong> dari arsip web, <strong>Media</strong> dari pemberitaan. Versi yang diketahui ada tetapi berkasnya belum ditemukan
    tetap dicantumkan dan tidak pernah direka ulang.
  </p>
  <ul class="plain">
    {docs.map((d) => {
      const p = PROVENANCE[provenanceKey(d.provenance)];
      return (
        <li class="card" id={d.id}>
          <div>
            <span class={`badge ${provenanceKey(d.provenance)}`} title={p.hint}>{p.label}</span>
            {" "}<strong>{DOC_TYPE[d.type] ?? d.type}</strong>
            <span class="muted"> · {tanggal(d.date)}</span>
          </div>
          {d.label && <div class="small">{d.label}</div>}
          {d.note && <div class="muted small">{d.note}</div>}
          <div class="small links">
            {d.text && <a href={`${base}ruu/${ruu.slug}/${d.id}/`}>Baca teks</a>}
            {d.source_url && <a href={d.source_url}>Sumber{d.obtained_by ? ` (${d.obtained_by})` : ""}</a>}
            {d.archive_url && <a href={d.archive_url}>Salinan arsip (PDF)</a>}
          </div>
        </li>
      );
    })}
  </ul>
</Base>

<style>
  .timeline { list-style: none; padding-left: 0; border-left: 2px solid var(--line); margin-left: 0.4rem; }
  .timeline li { padding: 0 0 1rem 1rem; position: relative; }
  .timeline li::before {
    content: ""; position: absolute; left: -7px; top: 0.45rem; width: 12px; height: 12px;
    border-radius: 50%; background: var(--surface); border: 2px solid var(--accent);
  }
  .links { margin-top: 0.4rem; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
</style>
