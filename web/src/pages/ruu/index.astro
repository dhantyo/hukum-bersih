---
import Base from "../../layouts/Base.astro";
import { loadRuus, versions } from "../../lib/data.ts";
import { tanggal } from "../../lib/labels.ts";
const ruus = loadRuus();
const base = import.meta.env.BASE_URL;
---
<Base title="RUU" description="Rancangan undang-undang yang dilacak beserta versi-versinya.">
  <h1>Rancangan Undang-Undang</h1>
  <p class="muted">Setiap RUU dilacak beserta semua versi draf yang pernah muncul dan asal-usulnya.</p>
  <ul class="plain">
    {ruus.map((r) => {
      const last = r.stages.at(-1);
      return (
        <li class="card">
          <a href={`${base}ruu/${r.slug}/`}><strong>{r.short_name ?? r.title}</strong></a>
          <div class="small">{r.title}</div>
          <div class="muted small">
            {versions(r).length} versi teks
            {last && <> · tahap terakhir: {tanggal(last.date)}{last.note ? ` (${last.note})` : ""}</>}
          </div>
        </li>
      );
    })}
  </ul>
</Base>
