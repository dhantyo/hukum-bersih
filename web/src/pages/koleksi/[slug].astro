---
// One collection: the laws inside it, in order (replaced laws, the base law, each amendment,
// with gaps for amendments we have not recorded), and the version comparer.
import Base from "../../layouts/Base.astro";
import VersionCompare from "../../components/VersionCompare.astro";
import KoleksiTimeline from "../../components/KoleksiTimeline.astro";
import MergedView from "../../components/MergedView.astro";
import { mergedDoc } from "../../lib/merge.ts";
import { historyOf } from "../../lib/versions.ts";
import { amendmentSteps, compareData, hasAmendmentSteps, versionHistory } from "../../lib/amendments.ts";
import { amendments, loadKoleksi, members, type Koleksi } from "../../lib/koleksi.ts";
import { citeId, lawPath, loadRegulationText, STATUS_LABEL } from "../../lib/peraturan.ts";

export function getStaticPaths() {
  return loadKoleksi().map((k) => ({ params: { slug: k.slug }, props: { k } }));
}
const { k } = Astro.props as { k: Koleksi };
const base = import.meta.env.BASE_URL;
const list = members(k);
const doc = loadRegulationText(k.base);
const compare = hasAmendmentSteps(k.base) ? compareData(versionHistory(k.base, doc)) : undefined;
const compared = new Set(amendmentSteps(k.base, doc).map((s) => s.by.id));
const anchors = new Map((doc?.pasal ?? []).map((p) => [p.num, p.eId]));
const count = list.filter((m) => m.role !== "pendahulu").length;
// decision 0010: a family with versions opens on its latest version, merged automatically
const latest = historyOf(k.base)?.points.at(-1);
const merged = latest && latest.kind === "gabungan" ? mergedDoc(k, latest.id) : undefined;
---
{merged ? <MergedView k={k} merged={merged} latest /> : (
<Base noindex title={k.name} description={`${k.name}${k.named ? ` (${k.title})` : ""}: undang-undang pokok beserta semua perubahannya.`} section="koleksi">
  <nav class="breadcrumbs" aria-label="Lokasi">
    <a href={`${base}koleksi/`}>Koleksi</a><span aria-hidden="true">›</span><span>{k.name}</span>
  </nav>
  <p class="eyebrow">Koleksi</p>
  <h1>{k.name}</h1>
  {k.named && <p class="subtitle">{k.title}</p>}
  <div class="meta">
    <span>{count} undang-undang</span>
    {amendments(k) > 0 && <span class="badge diubah">diubah {amendments(k)}×</span>}
    {k.base.status && <span class={`badge ${k.base.status}`}>{STATUS_LABEL[k.base.status] ?? k.base.status}</span>}
  </div>

  <h2 class="section" id="riwayat">Riwayat</h2>
  <KoleksiTimeline k={k} compared={compared} anchors={anchors} />
  <p class="small links">
    <a href={`${base}${lawPath(k.base)}`}>Baca teks {citeId(k.base.id)}</a>
    {compare && <> · <a href={`${base}${lawPath(k.base)}?bandingkan`}>Rincian tiap perubahan, pasal demi pasal</a></>}
  </p>

  {compare ? <VersionCompare data={compare} /> : (
    amendments(k) > 0 && <p class="muted small">Perubahan-perubahan di koleksi ini belum dapat dibandingkan pasal demi pasal (teksnya belum terbaca).</p>
  )}
</Base>
)}

<style>
  .eyebrow { margin: var(--s-4) 0 0; font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--primary); }
  h1 { margin: var(--s-1) 0 0; }
  .subtitle { font-size: var(--fs-lg); color: var(--text-muted); margin: var(--s-1) 0 0; }
  .meta { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); align-items: center; margin-top: var(--s-3); font-size: var(--fs-sm); color: var(--text-muted); }
  .section { font-size: var(--fs-lg); margin: var(--s-6) 0 var(--s-2); }
  .links { margin-top: var(--s-3); }
</style>
