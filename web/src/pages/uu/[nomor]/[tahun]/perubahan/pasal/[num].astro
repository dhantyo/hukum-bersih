---
// One pasal through all its versions, one column per version, oldest left. Each column marks
// what is new compared with the column before it. Only for pasal changed more than once.
import Base from "../../../../../../layouts/Base.astro";
import { hasAmendmentSteps, pasalThrough, shortName, versionHistory } from "../../../../../../lib/amendments.ts";
import { tanggal } from "../../../../../../lib/labels.ts";
import { loadRegulations, loadRegulationText, pathOf, shortCite, type Regulation } from "../../../../../../lib/peraturan.ts";

export function getStaticPaths() {
  return loadRegulations().filter((r) => r.type === "uu" && hasAmendmentSteps(r)).flatMap((r) => {
    const h = versionHistory(r, loadRegulationText(r));
    return [...h.changedIn].filter(([, ks]) => ks.length > 1).map(([num]) => ({
      params: { nomor: r.number, tahun: String(r.year), num },
      props: { r, num, columns: pasalThrough(h, num), gaps: h.versions.map((v) => v.gapBefore) },
    }));
  });
}
const { r, num, columns, gaps } = Astro.props as {
  r: Regulation; num: string; columns: ReturnType<typeof pasalThrough>; gaps: number[];
};
const base = import.meta.env.BASE_URL;
const name = shortName(r) ?? shortCite(r);
const root = `${base}${pathOf(r.id)}perubahan/`;
---
<Base title={`${name}: Pasal ${num}, semua versi`} noindex section="peraturan">
  <nav class="breadcrumbs" aria-label="Lokasi">
    <a href={`${base}uu/`}>Undang-Undang</a><span aria-hidden="true">›</span>
    <a href={`${base}${pathOf(r.id)}`}>{shortCite(r)}</a><span aria-hidden="true">›</span>
    <a href={root}>Perubahan</a><span aria-hidden="true">›</span>
    <span>Pasal {num}</span>
  </nav>
  <h1>Pasal {num} {name}, dari versi ke versi</h1>
  <p class="lead">
    Satu kolom per versi, dari yang tertua. Yang <ins>ditandai</ins> adalah kata atau ayat yang baru
    dibanding kolom sebelumnya; yang <del>dicoret</del> hilang pada versi berikutnya.
  </p>

  <div class="strip" style={`--cols:${columns.length}`} tabindex="0" aria-label={`Pasal ${num} dalam ${columns.length} versi`}>
    {columns.map((c, n) => {
      const next = columns[n + 1]?.row;
      // words that disappear in the next version: struck through in this column
      const goneLater = new Set(next?.lines.filter((l) => l.a && (l.kind === "dihapus" || l.kind === "diganti" || l.kind === "berubah")).map((l) => l.a!) ?? []);
      return (
        <section class="col">
          <header>
            <strong>{c.version.label}</strong>
            {c.version.date && <span class="muted"> · {tanggal(c.version.date)}</span>}
            {gaps[c.k] > 0 && <p class="gap">{gaps[c.k]} perubahan sebelumnya belum tercatat</p>}
          </header>
          {c.slot?.deleted ? <p class="none">Dihapus</p>
            : c.slot?.unknown || !c.slot?.pasal ? <p class="none">Teks belum terbaca</p>
            : (c.row ? c.row.lines.filter((l) => l.b) : c.slot.pasal.lines.map((l) => ({ b: l, kind: "sama" as const, parts: [{ value: l.text }] }))).map((l) => {
                const nextLine = next?.lines.find((x) => x.a === l.b);
                const parts = nextLine && goneLater.has(l.b!) && nextLine.kind === "berubah"
                  ? nextLine.parts.filter((p) => !p.added).map((p) => ({ value: p.value, gone: !!p.removed, added: false }))
                  : l.kind === "diganti" || l.kind === "baru" ? [{ value: l.b!.text, added: true, gone: false }]
                  : l.parts.filter((p) => !p.removed).map((p) => ({ value: p.value, added: !!p.added, gone: false }));
                const allGone = nextLine && (nextLine.kind === "dihapus" || nextLine.kind === "diganti");
                return (
                  <p class={`line${allGone ? " gone" : ""}`} style={`--i:${l.b!.indent}`}>
                    <span class="num">{l.b!.num}</span>
                    <span class="txt">{parts.map((p) => p.added ? <ins>{p.value}</ins> : p.gone ? <del>{p.value}</del> : p.value)}</span>
                  </p>
                );
              })}
        </section>
      );
    })}
  </div>
  <p class="small"><a href={root}>← Semua perubahan</a></p>
</Base>

<style>
  .lead { max-width: var(--measure); }
  .strip {
    display: grid; grid-template-columns: repeat(var(--cols), minmax(19rem, 1fr)); gap: var(--s-4);
    overflow-x: auto; padding-bottom: var(--s-3); margin: var(--s-5) 0;
  }
  .col { border: 1px solid var(--line); border-radius: var(--r-md); padding: var(--s-3) var(--s-4); background: var(--bg); }
  .col header { position: sticky; top: 0; background: var(--bg); padding-bottom: var(--s-2); margin-bottom: var(--s-2); border-bottom: 1px solid var(--line); font-size: var(--fs-sm); }
  .gap { margin: var(--s-1) 0 0; color: var(--warn); font-size: var(--fs-xs); }
  .none { color: var(--text-muted); font-style: italic; }
  .line {
    --num: 2.1rem;
    display: grid; grid-template-columns: minmax(var(--num), max-content) 1fr; column-gap: 0.3rem;
    margin: 0 0 var(--s-2) calc(var(--i, 0) * var(--num));
    font-family: var(--font-law); font-size: var(--fs-law); line-height: 1.6;
  }
  .line .num:empty + .txt { grid-column: 1 / -1; }
  .line.gone .txt { text-decoration: line-through; color: var(--del-text); }
  ins { background: var(--ins-bg); color: var(--ins-text); text-decoration: none; }
  del { background: var(--del-bg); color: var(--del-text); }
  .lead ins, .lead del { padding: 0 0.15em; }
</style>
