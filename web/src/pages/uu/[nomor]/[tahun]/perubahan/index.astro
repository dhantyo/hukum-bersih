---
// The old "Perubahan" page (before / after of every changed pasal, amendment by amendment) is
// now part of the reading view (components/CompareMode.astro, decision 0010). This page only
// forwards old links: /uu/4/2009/perubahan/#uu_3_2020-pasal-4 opens the family's latest
// version comparing the step made by UU 3/2020, at Pasal 4.
import { hasAmendmentSteps } from "../../../../../lib/amendments.ts";
import { koleksiOf, koleksiPath } from "../../../../../lib/koleksi.ts";
import { versionRows } from "../../../../../lib/versions.ts";
import { lawPath, loadRegulations, loadRegulationText, type Regulation } from "../../../../../lib/peraturan.ts";

export function getStaticPaths() {
  return loadRegulations().filter((r) => r.type === "uu" && hasAmendmentSteps(r)).map((r) => ({
    params: { nomor: r.number, tahun: String(r.year) }, props: { r },
  }));
}
const { r } = Astro.props as { r: Regulation };
const base = import.meta.env.BASE_URL;
const k = koleksiOf(r.id);
const last = k ? versionRows(k).at(-1) : undefined;
// the latest merged version when there is one, else the original text; both can compare
const target = last?.href && last.point?.kind === "gabungan" ? last.href
  : k && k.base.id === r.id && loadRegulationText(r) ? `${base}${lawPath(r)}`
  : k ? `${base}${koleksiPath(k)}` : `${base}${lawPath(r)}`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Perubahan</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}?bandingkan`} />
    <script is:inline define:vars={{ target }}>
      // #uu_3_2020-pasal-4 -> ?bandingkan=uu_3_2020#pasal-4; #uu_3_2020 -> ?bandingkan=uu_3_2020
      const m = decodeURIComponent(location.hash.slice(1)).match(/^([a-z]+_[0-9a-z]+_\d{4})(?:-pasal-(.+))?$/i);
      const q = m ? `?bandingkan=${m[1]}` : "?bandingkan";
      const h = m && m[2] ? `#pasal-${m[2].toLowerCase().replace(/[^0-9a-z]+/g, "")}` : "";
      location.replace(target + q + h);
    </script>
  </head>
  <body>
    <p>Halaman ini sudah pindah. <a href={`${target}?bandingkan`}>Buka perbandingan versi</a>.</p>
  </body>
</html>
