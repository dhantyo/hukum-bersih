---
// Any two versions of an amended law, side by side: every pasal that changed in between.
// "Version" = the original text or the text after an amendment we can read (lib/amendments.ts).
import Base from "../../../../../layouts/Base.astro";
import SynRow from "../../../../../components/SynRow.astro";
import VersionPicker from "../../../../../components/VersionPicker.astro";
import { comparePair, hasAmendmentSteps, shortName, versionHistory, type VersionHistory } from "../../../../../lib/amendments.ts";
import { loadRegulations, loadRegulationText, pathOf, shortCite, type Regulation } from "../../../../../lib/peraturan.ts";

export function getStaticPaths() {
  return loadRegulations().filter((r) => r.type === "uu" && hasAmendmentSteps(r)).flatMap((r) => {
    const h = versionHistory(r, loadRegulationText(r));
    return h.versions.flatMap((a, i) => h.versions.slice(i + 1).map((b, d) => ({
      params: { nomor: r.number, tahun: String(r.year), pair: `${a.id}...${b.id}` },
      props: { r, h, i, j: i + 1 + d },
    })));
  });
}
const { r, h, i, j } = Astro.props as { r: Regulation; h: VersionHistory; i: number; j: number };
const base = import.meta.env.BASE_URL;
const a = h.versions[i], b = h.versions[j];
const rows = comparePair(h, i, j);
const name = shortName(r) ?? shortCite(r);
const root = `${base}${pathOf(r.id)}perubahan/`;
const gaps = h.versions.slice(i + 1, j + 1).reduce((n, v) => n + v.gapBefore, 0);
const between = j - i - 1;
const LABEL = { berubah: "diubah", baru: "pasal baru", dihapus: "dihapus", sama: "sama" } as const;
const counts = { berubah: 0, baru: 0, dihapus: 0, unknown: 0 };
for (const x of rows) {
  if (x.b.unknown || (!x.a?.pasal && !x.b.pasal)) counts.unknown++;
  else if (x.b.deleted) counts.dihapus++;
  else if (!x.a?.pasal) counts.baru++;
  else counts.berubah++;
}
---
<Base title={`${name}: ${a.label} → ${b.label}`} noindex section="peraturan">
  <nav class="breadcrumbs" aria-label="Lokasi">
    <a href={`${base}uu/`}>Undang-Undang</a><span aria-hidden="true">›</span>
    <a href={`${base}${pathOf(r.id)}`}>{shortCite(r)}</a><span aria-hidden="true">›</span>
    <a href={root}>Perubahan</a><span aria-hidden="true">›</span>
    <span>{a.label} → {b.label}</span>
  </nav>
  <h1>{name}: {a.label} → {b.label}</h1>
  <p class="lead">
    Semua pasal yang berbeda antara kedua versi{between > 0 && <>, termasuk perubahan oleh {h.versions.slice(i + 1, j).map((v) => v.label).join(", ")} di antaranya</>}.
  </p>
  <VersionPicker versions={h.versions} root={root} from={a.id} to={b.id} />

  <div class="summary small">
    <span><b>{counts.berubah}</b> diubah</span>
    <span><b>{counts.baru}</b> pasal baru</span>
    <span><b>{counts.dihapus}</b> dihapus</span>
    {counts.unknown > 0 && <span><b>{counts.unknown}</b> belum terbaca</span>}
  </div>
  {gaps > 0 && (
    <p class="notice warn small">
      Ada {gaps} perubahan di antara kedua versi ini yang belum tercatat (biasanya melalui UU Cipta Kerja).
      Pasal yang diubah olehnya tidak tampak di sini, dan teks "{a.label}" mungkin bukan teks yang berlaku
      tepat sebelumnya.
    </p>
  )}

  <div class="syn-head"><div>{a.label}</div><div>{b.label}</div></div>
  {rows.map((x) => {
    const status = x.b.deleted ? "dihapus" : !x.a?.pasal && x.b.pasal ? "baru" : "berubah";
    return (
      <SynRow r={x.row} anchor={`pasal-${x.num}`} label={x.row.status === "sama" ? "sama" : LABEL[status]}
        verA={x.a?.pasal ? a.label : ""} verB={b.label}
        noneA={x.a?.unknown ? `Pasal ${x.num}: teks belum terbaca` : x.a?.deleted ? `Pasal ${x.num}: sudah dihapus` : `Pasal ${x.num}: belum ada pada versi ini`}
        noneB={x.b.deleted ? `Pasal ${x.num} dihapus` : `Pasal ${x.num}: teks belum terbaca dari PDF`}>
        {(h.changedIn.get(x.num)?.length ?? 0) > 1 && (
          <a slot="meta" class="tag all" href={`${root}pasal/${x.num}/`}>semua versi Pasal {x.num} →</a>
        )}
      </SynRow>
    );
  })}
  {rows.length === 0 && <p class="muted">Tidak ada pasal yang berbeda.</p>}
</Base>

<style>
  .lead { max-width: var(--measure); }
  .summary { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin: var(--s-5) 0 var(--s-3); }
  .notice { background: var(--bg-subtle); border-left: 3px solid var(--warn); padding: var(--s-3) var(--s-4); border-radius: var(--r-sm); max-width: var(--measure); }
  .syn-head {
    display: grid; grid-template-columns: 1fr 1fr; column-gap: 1.5rem; margin-top: var(--s-5);
    position: sticky; top: 0; z-index: 1; background: var(--bg); padding: 0.6rem 0;
    border-bottom: 2px solid var(--line); font-weight: 700; font-size: 0.9rem;
  }
  .all { font-weight: 600; }
  @media (max-width: 760px) { .syn-head { display: none; } }
</style>
