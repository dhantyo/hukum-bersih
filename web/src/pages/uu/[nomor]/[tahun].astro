---
import Base from "../../../layouts/Base.astro";
import DocLayout from "../../../components/DocLayout.astro";
import Facts from "../../../components/Facts.astro";
import LawText from "../../../components/LawText.astro";
import Toc from "../../../components/Toc.astro";
import KoleksiBox from "../../../components/KoleksiBox.astro";
import RelationsBanner from "../../../components/RelationsBanner.astro";
import StatusBanner from "../../../components/StatusBanner.astro";
import { tanggal } from "../../../lib/labels.ts";
import { amendmentSteps, shortName } from "../../../lib/amendments.ts";
import { koleksiOf, koleksiPath } from "../../../lib/koleksi.ts";
import { amendmentCount, citeId, lawPath, loadRegulations, loadRegulationText, pasalNotes, pathOf, shortCite, sourceName, STATUS_LABEL, type Regulation } from "../../../lib/peraturan.ts";

export function getStaticPaths() {
  return loadRegulations().filter((r) => r.type === "uu").map((r) => ({
    params: { nomor: r.number, tahun: String(r.year) }, props: { r },
  }));
}
const { r } = Astro.props as { r: Regulation };
const base = import.meta.env.BASE_URL;
const doc = loadRegulationText(r);
const status = r.status ?? "";
const pasal = r.versions.find((v) => v.pasal_count)?.pasal_count;
const amendments = amendmentCount(r);
const steps = amendmentSteps(r, doc);
const comparedPasal = new Set(steps.flatMap((s) => s.changes.map((c) => c.anchor)));
// "Diubah oleh UU 19/2016": to the before/after comparison of that pasal when there is one
const notes = new Map([...pasalNotes(r)].map(([n, ids]) => [n, ids.map((id) => ({
  label: citeId(id),
  href: comparedPasal.has(`${id}-pasal-${n}`) ? `${base}${lawPath(r)}perubahan/#${id}-pasal-${n}`
    : pathOf(id) ? `${base}${pathOf(id)}` : undefined,
}))]));
const short = shortName(r);
const koleksi = koleksiOf(r.id);
---
<Base title={`${short ? `${short} (${shortCite(r)})` : shortCite(r)}${r.subject ? ` tentang ${r.subject}` : ""}`} description={`${r.title}${r.subject ? ` tentang ${r.subject}` : ""}`} section="peraturan">
  <DocLayout
    crumbs={koleksi?.named
      ? [{ href: `${base}koleksi/`, label: "Koleksi" }, { href: `${base}${koleksiPath(koleksi)}`, label: koleksi.name }, { label: shortCite(r) }]
      : [{ href: `${base}uu/`, label: "Undang-Undang" }, { href: `${base}uu/tahun/${r.year}/`, label: String(r.year) }, { label: shortCite(r) }]}
    eyebrow={r.title}
    title={r.subject || r.title}
    panelLabel={doc ? "Daftar isi dan keterangan" : "Keterangan"}
  >
    <div slot="head" class="head-meta">
      {status && <span class={`badge ${status}`}>{STATUS_LABEL[status] ?? status}</span>}
      {r.tanggal_penetapan && <span class="muted small">Ditetapkan {tanggal(r.tanggal_penetapan)}</span>}
      {pasal && <span class="muted small">{pasal} pasal</span>}
      {amendments > 0 && <a class="badge diubah" href={koleksi ? `${base}${koleksiPath(koleksi)}#riwayat` : undefined}>diubah {amendments}×</a>}
    </div>
    <Fragment slot="panel">
      {doc && <Toc doc={doc} />}
      <Facts title="Keterangan" facts={[
        { label: "Ditetapkan", value: r.tanggal_penetapan ? `${tanggal(r.tanggal_penetapan)}${r.tempat_penetapan ? `, ${r.tempat_penetapan}` : ""}` : null },
        { label: "Oleh", value: r.pejabat_penetapan },
        { label: "Pemrakarsa", value: r.pemrakarsa },
      ]} />
      <Facts title="Sumber" facts={[
        { label: "Halaman resmi", value: sourceName(r.source_url), href: r.source_url },
        { label: "PDF resmi", value: "Unduh PDF", href: r.source_pdf_url ?? undefined },
        { label: "Salinan arsip", value: r.archive_url ? "archive.org" : null, href: r.archive_url },
      ]} />
    </Fragment>
    <StatusBanner r={r} hasText={!!doc}
      perubahanHref={steps.length > 0 ? `${base}${lawPath(r)}perubahan/` : undefined}
      riwayatHref={koleksi ? `${base}${koleksiPath(koleksi)}#riwayat` : undefined} />
    {koleksi ? <KoleksiBox k={koleksi} r={r} /> : <RelationsBanner r={r} />}
    {doc ? (
      <>
        <p class="notice small" data-pagefind-ignore>Teks ini diambil otomatis dari PDF resmi dan bisa memuat kesalahan baca. Bila ragu, periksa <a href={r.source_pdf_url ?? r.source_url}>PDF resminya</a>.</p>
        <LawText doc={doc} notes={notes} />
      </>
    ) : (
      <div class="notice">
        <p><strong>Teks belum tersedia.</strong></p>
        <p>
          {r.pdf_quality ? "PDF resminya berupa hasil pindaian tanpa lapisan teks; teksnya akan diambil dengan OCR."
            : r.parse_error ? "Struktur PDF resminya belum bisa dibaca dengan benar; kami tidak menampilkan teks yang mungkin keliru."
            : "PDF resminya belum diproses."}
        </p>
        {r.source_pdf_url && <p><a class="btn" href={r.source_pdf_url}>Buka PDF resmi</a></p>}
      </div>
    )}
  </DocLayout>
</Base>

<style>
  .koleksi {
    display: inline-flex; gap: var(--s-2); align-items: baseline; text-decoration: none; font-weight: 600; color: var(--primary);
    border: 1px solid var(--primary); border-radius: var(--r-sm); padding: var(--s-0) var(--s-2); font-size: var(--fs-sm);
  }
  .koleksi:hover { background: var(--primary-bg); }
  .k-label { font-size: var(--fs-xs); font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
  .head-meta { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); align-items: center; }
  .notice { background: var(--bg-subtle); padding: var(--s-3) var(--s-4); border-radius: var(--r-md); max-width: var(--measure); }
  .notice p:last-child { margin-bottom: 0; }
</style>
