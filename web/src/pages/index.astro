---
import Base from "../layouts/Base.astro";
import LawRows from "../components/LawRows.astro";
import { loadRuus, versions } from "../lib/data.ts";
import { tanggal } from "../lib/labels.ts";
import { JENIS, loadRegulations } from "../lib/peraturan.ts";

const base = import.meta.env.BASE_URL;
const ruus = loadRuus();
const laws = loadRegulations().filter((r) => r.type === "uu");
const others = Object.keys(JENIS).filter((t) => t !== "uu")
  .map((t) => [t, loadRegulations().filter((r) => r.type === t).length] as const).filter(([, n]) => n > 0);
const withText = laws.filter((r) => r.versions.some((v) => v.text)).length;
---
<Base noindex search={false} title="Beranda" description="Teks hukum Indonesia yang bersih dan mudah dibaca, serta pelacakan RUU beserta setiap versi drafnya.">
  <section class="hero">
    <h1>Hukum Indonesia, mudah dibaca.</h1>
    <p class="lead">Teks undang-undang yang bersih dan bisa dicari, serta rancangan undang-undang beserta setiap versinya: dari mana asalnya, dan apa yang berubah.</p>
    <form class="big-search" action={`${base}cari/`} method="get" role="search">
      <label class="visually-hidden" for="hero-q">Cari</label>
      <input id="hero-q" name="q" type="search" placeholder="Contoh: perampasan aset, pasal 27 ITE, perkawinan…" />
      <button class="btn primary" type="submit">Cari</button>
    </form>
    <p class="stats small muted">
      <a href={`${base}uu/`}>{laws.length.toLocaleString("id-ID")} undang-undang</a> ({withText.toLocaleString("id-ID")} sebagai teks)
      {others.map(([t, n]) => <> · <a href={`${base}${t}/`}>{n.toLocaleString("id-ID")} {JENIS[t].short}</a></>)}
      · <a href={`${base}ruu/`}>{ruus.length} RUU dilacak</a>
    </p>
  </section>

  <div class="cols">
    <section>
      <h2>RUU yang dilacak</h2>
      <ul class="rows">
        {ruus.map((r) => {
          const last = r.stages.at(-1);
          const v = versions(r);
          return (
            <li>
              <a class="row-title" href={`${base}ruu/${r.slug}/`}>{r.short_name ?? r.title}</a>
              <div class="row-meta">
                {last && <>Tahap terakhir: {last.note ?? last.stage} ({tanggal(last.date)})</>}
                {v.length > 1 && <> · <a href={`${base}ruu/${r.slug}/beda/${v[0].id}...${v.at(-1)!.id}/`}>lihat apa yang berubah</a></>}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
    <section>
      <h2>Undang-undang terbaru</h2>
      <LawRows laws={laws.slice(0, 6)} />
      <p class="small"><a href={`${base}uu/`}>Semua undang-undang →</a></p>
    </section>
  </div>
</Base>

<style>
  .hero { padding: var(--s-8) 0 var(--s-6); max-width: 46rem; }
  .hero h1 { font-size: clamp(var(--fs-xl), 5vw, var(--fs-2xl)); margin-bottom: var(--s-4); }
  .lead { font-size: var(--fs-lg); color: var(--text-muted); }
  .big-search { display: flex; gap: var(--s-2); margin: var(--s-5) 0 var(--s-3); }
  .big-search input {
    flex: 1; font: inherit; font-size: var(--fs-lg); padding: var(--s-3) var(--s-4);
    border: 2px solid var(--text); border-radius: var(--r-sm); background: var(--bg); color: var(--text); min-width: 0;
  }
  .big-search input:focus { outline: 3px solid var(--primary); outline-offset: 0; border-color: var(--primary); }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-7); }
  .cols h2 { margin-top: var(--s-5); }
  @media (max-width: 800px) {
    .hero { padding-top: var(--s-6); }
    .cols { grid-template-columns: 1fr; gap: 0; }
    .big-search .btn { padding: var(--s-3); }
  }
</style>
