---
// Compare any versions of an amended law, side by side: one column per chosen version. The
// reader adds, removes, drags (or moves with the arrow keys) and switches versions; each
// column marks what changed since the column to its left. Runs in the browser on a compact
// copy of the changed pasal (lib/amendments.ts compareData), so any combination works without
// a page per pair. State is kept in the URL (?v=a,b,c&pasal=5) so a view can be shared.
import type { CompareData } from "../lib/amendments.ts";
interface Props { data: CompareData }
const { data } = Astro.props;
---
<section class="vc" id="banding" aria-labelledby="banding-title">
  <h2 id="banding-title">Bandingkan versi</h2>
  <p class="muted small help">
    Pilih versi yang ingin dibandingkan. Tambah atau hapus kolom, geser untuk mengubah urutan.
    Tiap kolom menandai yang <ins>baru</ins> dan yang <del>dihapus</del> dibanding kolom di kirinya.
  </p>
  <div class="bar">
    <ol class="slots" aria-label="Versi yang dibandingkan"></ol>
    <button type="button" class="add">+ Tambah versi</button>
  </div>
  <div class="tools">
    <span class="presets small">
      <span class="muted">Cepat:</span>
      <button type="button" data-preset="ends">Asli dan terbaru</button>
      <button type="button" data-preset="all">Semua versi</button>
      <button type="button" data-preset="last">Perubahan terakhir</button>
    </span>
    <label class="find small">Pasal <input type="search" class="pasal" placeholder="mis. 5 atau 17A" autocomplete="off" /></label>
  </div>
  <p class="gapnote small" hidden></p>
  <p class="summary small muted" aria-live="polite"></p>
  <div class="grid" tabindex="0"></div>
  <button type="button" class="more" hidden>Tampilkan lebih banyak pasal</button>
  <script type="application/json" class="vc-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
</section>

<script>
  import { diffLines, type LineDiff } from "../lib/compare.ts";
  import type { Pasal } from "../lib/lawtext.ts";
  import type { CompareData, CompactSlot } from "../lib/amendments.ts";

  for (const root of document.querySelectorAll<HTMLElement>(".vc")) {
    const data: CompareData = JSON.parse(root.querySelector(".vc-data")!.textContent!);
    const V = data.versions;
    const ids = V.map((v) => v.id);
    const params = new URLSearchParams(location.search);
    let chosen = (params.get("v")?.split(",").filter((id) => ids.includes(id)) ?? []);
    if (chosen.length < 2) chosen = [ids[0], ids[ids.length - 1]];
    let filter = params.get("pasal") ?? "";
    let shown = 25;

    const slots = root.querySelector<HTMLOListElement>(".slots")!;
    const grid = root.querySelector<HTMLElement>(".grid")!;
    const more = root.querySelector<HTMLButtonElement>(".more")!;
    const addBtn = root.querySelector<HTMLButtonElement>(".add")!;
    const find = root.querySelector<HTMLInputElement>(".pasal")!;
    const summary = root.querySelector<HTMLElement>(".summary")!;
    const gapnote = root.querySelector<HTMLElement>(".gapnote")!;
    find.value = filter;

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = "", ...kids: (Node | string)[]) => {
      const e = document.createElement(tag); if (cls) e.className = cls; e.append(...kids); return e;
    };
    const label = (id: string) => { const v = V[ids.indexOf(id)]; return `${v.label}${v.date ? ` · ${v.date.slice(0, 4)}` : ""}`; };

    function save() {
      const u = new URL(location.href);
      u.searchParams.set("v", chosen.join(","));
      if (filter) u.searchParams.set("pasal", filter); else u.searchParams.delete("pasal");
      history.replaceState(null, "", u);
    }

    // ---- version slots ----
    let dragFrom = -1;
    function drawSlots() {
      slots.replaceChildren(...chosen.map((id, i) => {
        const sel = el("select");
        sel.setAttribute("aria-label", `Versi kolom ${i + 1}`);
        for (const v of V) {
          const o = new Option(v.label, v.id, false, v.id === id);
          sel.add(o);
        }
        sel.onchange = () => { chosen[i] = sel.value; update(); };
        const grip = el("span", "grip", "⠿");
        grip.tabIndex = 0;
        grip.setAttribute("role", "button");
        grip.setAttribute("aria-label", `Geser kolom ${i + 1} (panah kiri/kanan)`);
        grip.onkeydown = (e) => {
          const to = e.key === "ArrowLeft" ? i - 1 : e.key === "ArrowRight" ? i + 1 : -1;
          if (to < 0 || to >= chosen.length) return;
          e.preventDefault();
          chosen.splice(to, 0, chosen.splice(i, 1)[0]);
          update();
          (slots.children[to].querySelector(".grip") as HTMLElement).focus();
        };
        const rm = el("button", "rm", "×");
        rm.type = "button";
        rm.setAttribute("aria-label", `Hapus kolom ${i + 1}`);
        rm.disabled = chosen.length <= 2;
        rm.onclick = () => { chosen.splice(i, 1); update(); };
        const li = el("li", "slot", grip, sel, rm);
        li.draggable = true;
        li.ondragstart = (e) => { dragFrom = i; li.classList.add("dragging"); e.dataTransfer?.setData("text/plain", String(i)); };
        li.ondragend = () => li.classList.remove("dragging");
        li.ondragover = (e) => { e.preventDefault(); li.classList.add("over"); };
        li.ondragleave = () => li.classList.remove("over");
        li.ondrop = (e) => {
          e.preventDefault();
          if (dragFrom >= 0 && dragFrom !== i) chosen.splice(i, 0, chosen.splice(dragFrom, 1)[0]);
          dragFrom = -1; update();
        };
        return li;
      }));
      addBtn.disabled = chosen.length >= V.length;
    }
    addBtn.onclick = () => {
      const last = ids.indexOf(chosen[chosen.length - 1]);
      const next = ids.find((id, k) => k > last && !chosen.includes(id)) ?? ids.find((id) => !chosen.includes(id));
      if (next) { chosen.push(next); update(); }
    };
    root.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) => b.onclick = () => {
      chosen = b.dataset.preset === "all" ? [...ids] : b.dataset.preset === "last" ? ids.slice(-2) : [ids[0], ids[ids.length - 1]];
      update();
    });
    find.oninput = () => { filter = find.value.trim().toUpperCase().replace(/^PASAL\s*/, ""); shown = 25; save(); drawGrid(); };

    // ---- the comparison ----
    const at = (changes: [number, CompactSlot][], vi: number): CompactSlot => {
      let s: CompactSlot = null;
      for (const [k, slot] of changes) if (k <= vi) s = slot;
      return s;
    };
    const toPasal = (num: string, s: CompactSlot): Pasal | undefined =>
      Array.isArray(s) ? { label: `Pasal ${num}`, num, eId: num, lines: s.map(([n, text, indent]) => ({ num: n ?? undefined, text, indent })) } : undefined;

    function cell(num: string, s: CompactSlot, prev: Pasal | undefined, first: boolean) {
      const c = el("div", "cell");
      if (s === "d") { c.append(el("p", "none", "Dihapus")); c.classList.add("gone"); return c; }
      if (s === "u") { c.append(el("p", "none", "Teks belum terbaca dari PDF")); return c; }
      if (s === null) { c.append(el("p", "none", "Belum ada")); return c; }
      const cur = toPasal(num, s)!;
      const lines: LineDiff[] = !first && prev ? diffLines(prev, cur)
        : cur.lines.map((l) => ({ kind: first ? "sama" : "baru", b: l, parts: [{ value: l.text, added: !first }] }));
      for (const l of lines) {
        const line = l.b ?? l.a!;
        const p = el("p", `line ${l.kind}`);
        p.style.setProperty("--i", String(line.indent));
        p.append(el("span", "num", line.num ?? ""));
        const txt = el("span", "txt");
        const parts = l.kind === "diganti" ? l.parts : l.parts;
        for (const part of parts) {
          txt.append(part.added ? el("ins", "", part.value) : part.removed ? el("del", "", part.value) : part.value);
        }
        p.append(txt);
        c.append(p);
      }
      return c;
    }

    function drawGrid() {
      const cols = chosen.map((id) => ids.indexOf(id));
      grid.style.setProperty("--cols", String(cols.length));
      const head = el("div", "row head");
      for (const vi of cols) {
        const v = V[vi];
        head.append(el("div", "cell", el("strong", "", v.label), v.date ? el("span", "muted", ` · ${v.date}`) : ""));
      }
      const rows: HTMLElement[] = [];
      let differ = 0;
      for (const [num, changes] of data.pasal) {
        if (filter && num.toUpperCase() !== filter) continue;
        const ss = cols.map((vi) => at(changes, vi));
        if (!filter && ss.every((s) => JSON.stringify(s) === JSON.stringify(ss[0]))) continue;
        differ++;
        if (rows.length >= shown) continue;
        const row = el("div", "row");
        row.append(el("h3", "pasal-title", `Pasal ${num}`));
        let prev: Pasal | undefined;
        ss.forEach((s, k) => {
          const c = cell(num, s, prev, k === 0);
          c.dataset.v = V[cols[k]].label;           // shown above each cell on phones
          row.append(c); prev = toPasal(num, s);
        });
        rows.push(row);
      }
      grid.replaceChildren(head, ...rows);
      summary.textContent = filter
        ? (differ ? `Pasal ${filter} dalam ${cols.length} versi.` : `Pasal ${filter} tidak berubah di antara perubahan yang kami punya.`)
        : `${differ} pasal berbeda di antara ${cols.length} versi ini.`;
      more.hidden = rows.length >= differ;
      // amendments we lack between the first and last chosen version
      const lo = Math.min(...cols), hi = Math.max(...cols);
      const gaps = V.slice(lo + 1, hi + 1).reduce((n, v) => n + v.gap, 0);
      gapnote.hidden = gaps === 0;
      gapnote.textContent = `Ada ${gaps} perubahan di antara versi-versi ini yang belum tercatat (biasanya melalui UU Cipta Kerja); pasal yang diubah olehnya tidak tampak di sini.`;
    }
    more.onclick = () => { shown += 50; drawGrid(); };

    function update() { save(); drawSlots(); drawGrid(); }
    update();
  }
</script>

<style>
  .vc { margin: var(--s-6) 0; }
  .vc h2 { margin-bottom: var(--s-1); }
  .help { max-width: var(--measure); margin-top: 0; }
  .help ins, .help del { padding: 0 0.15em; }
  .bar { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; padding: var(--s-3); background: var(--bg-subtle); border: 1px solid var(--line); border-radius: var(--r-md); }
  .slots { display: contents; list-style: none; }
  .vc :global(.slot) {
    display: flex; align-items: center; gap: var(--s-1); padding: var(--s-1); background: var(--bg);
    border: 1px solid var(--line-strong); border-radius: var(--r-sm); min-height: var(--tap);
  }
  .vc :global(.slot.dragging) { opacity: 0.5; }
  .vc :global(.slot.over) { border-color: var(--primary); }
  .vc :global(.grip) { cursor: grab; color: var(--text-muted); padding: 0 var(--s-1); user-select: none; line-height: 2rem; }
  .vc :global(.grip:focus-visible) { outline: 2px solid var(--primary); border-radius: var(--r-sm); }
  .vc :global(.slot select) { font: inherit; font-size: var(--fs-sm); border: 0; background: transparent; color: var(--text); min-height: 2rem; max-width: 15rem; }
  .vc :global(.rm) { border: 0; background: none; color: var(--text-muted); font: inherit; font-size: var(--fs-lg); width: var(--tap); height: var(--tap); cursor: pointer; border-radius: var(--r-sm); }
  .vc :global(.rm:hover:not(:disabled)) { background: var(--del-bg); color: var(--del-text); }
  .vc :global(.rm:disabled) { opacity: 0.3; cursor: default; }
  .add { font: inherit; font-size: var(--fs-sm); font-weight: 600; color: var(--primary); background: none; border: 1px dashed var(--primary); border-radius: var(--r-sm); min-height: var(--tap); padding: 0 var(--s-3); cursor: pointer; }
  .add:disabled { opacity: 0.4; cursor: default; }
  .tools { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-4); align-items: center; margin: var(--s-3) 0; }
  .presets { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; }
  .presets button { font: inherit; background: none; border: 1px solid var(--line-strong); border-radius: 999px; padding: 0.2rem var(--s-3); color: var(--text); cursor: pointer; }
  .presets button:hover { border-color: var(--primary); color: var(--primary); }
  .find { display: flex; gap: var(--s-2); align-items: center; }
  .find input { font: inherit; padding: var(--s-1) var(--s-2); border: 1px solid var(--line-strong); border-radius: var(--r-sm); background: var(--bg); color: var(--text); width: 9rem; }
  .gapnote { border: 1px solid var(--warn); border-radius: var(--r-md); padding: var(--s-2) var(--s-3); max-width: var(--measure); }

  .grid { overflow-x: auto; }
  .vc :global(.row) { display: grid; grid-template-columns: repeat(var(--cols), minmax(17rem, 1fr)); column-gap: var(--s-4); padding: var(--s-3) 0; border-bottom: 1px solid var(--line); }
  .vc :global(.row.head) { position: sticky; top: var(--header-shown, 0px); z-index: 1; background: var(--bg); border-bottom: 2px solid var(--line); font-size: var(--fs-sm); padding: var(--s-2) 0; }
  .vc :global(.pasal-title) { grid-column: 1 / -1; font-size: var(--fs-base); margin: 0 0 var(--s-2); }
  .vc :global(.cell) { min-width: 0; }
  .vc :global(.cell .none) { color: var(--text-muted); font-style: italic; margin: 0; }
  .vc :global(.line) {
    --num: 2.1rem; display: grid; grid-template-columns: minmax(var(--num), max-content) 1fr; column-gap: 0.3rem;
    margin: 0 0 var(--s-2) calc(var(--i, 0) * var(--num)); font-family: var(--font-law); font-size: var(--fs-law); line-height: 1.6;
  }
  .vc :global(.line .num:empty + .txt) { grid-column: 1 / -1; }
  .vc :global(.line.baru .txt) { background: var(--ins-bg); color: var(--ins-text); }
  .vc :global(.line.dihapus .txt) { background: var(--del-bg); color: var(--del-text); text-decoration: line-through; }
  .vc :global(ins), .help ins { background: var(--ins-bg); color: var(--ins-text); text-decoration: none; }
  .vc :global(del), .help del { background: var(--del-bg); color: var(--del-text); }
  @media (max-width: 760px) {
    /* phones: versions under each other, each labelled, instead of side by side */
    .vc :global(.row) { grid-template-columns: 1fr; }
    .vc :global(.row.head) { display: none; }
    .vc :global(.cell[data-v])::before {
      content: attr(data-v); display: block; font-size: var(--fs-xs); font-weight: 600; color: var(--text-muted);
      text-transform: uppercase; letter-spacing: 0.06em; margin: var(--s-2) 0 var(--s-1);
    }
    .vc :global(.slot) { flex: 1 1 100%; }
    .vc :global(.slot select) { flex: 1; max-width: none; }
  }
  .more { margin-top: var(--s-3); font: inherit; font-size: var(--fs-sm); background: none; border: 1px solid var(--line-strong); border-radius: var(--r-sm); padding: var(--s-1) var(--s-3); color: var(--primary); cursor: pointer; }
</style>
