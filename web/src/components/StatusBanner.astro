---
// Above a law's text: whether the text shown is the law as it stands. A repealed law says so
// and links to what repealed it; an amended law says the text is the original wording and
// links to the pasal-by-pasal changes. Pattern from legislation.gov.uk ("changes to
// legislation") and Fedlex ("nicht mehr in Kraft"); see docs/decisions/0008-law-history.md.
import { tanggal } from "../lib/labels.ts";
import { amendmentCount, byId, citeId, pasalNotes, pathOf, rel, sourceName, type Regulation } from "../lib/peraturan.ts";

interface Props { r: Regulation; hasText: boolean; perubahanHref?: string; riwayatHref?: string }
const { r, hasText, perubahanHref, riwayatHref } = Astro.props;
const base = import.meta.env.BASE_URL;
const R = rel(r);
const gone = r.status === "dicabut" || r.status === "tidak_berlaku";
const revokers = R.revoked_by.map((id) => {
  const by = byId(id);
  const p = pathOf(id);
  return {
    label: by?.subject ? `${citeId(id)} tentang ${by.subject}` : citeId(id),
    href: p ? `${base}${p}` : undefined,
    date: by?.tanggal_penetapan ?? null,
  };
});
const times = amendmentCount(r);
const changedPasal = pasalNotes(r).size;
const year = r.tanggal_penetapan?.slice(0, 4) ?? String(r.year);
const changesHref = perubahanHref ?? riwayatHref;
---
{gone ? (
  <aside class="status-banner gone" aria-label="Status undang-undang">
    <p class="head">Undang-undang ini sudah tidak berlaku.</p>
    {revokers.length > 0 ? (
      <p>
        Dicabut oleh {revokers.map((v, i) => (
          <>{i > 0 && (i === revokers.length - 1 ? " dan " : ", ")}{v.href ? <a href={v.href}>{v.label}</a> : v.label}{v.date && <> ({tanggal(v.date)})</>}</>
        ))}.
        {hasText && " Teks di bawah ini disimpan sebagai arsip sejarah."}
      </p>
    ) : (
      <p>
        Menurut <a href={r.source_url}>{sourceName(r.source_url)}</a>, statusnya {r.status === "dicabut" ? "dicabut" : "tidak berlaku"}.
        {hasText && " Teks di bawah ini disimpan sebagai arsip sejarah."}
      </p>
    )}
  </aside>
) : times > 0 && hasText ? (
  <aside class="status-banner changed" aria-label="Status teks">
    <p class="head">Ini teks asli tahun {year}, belum memuat perubahannya.</p>
    <p>
      Undang-undang ini sudah diubah {times}×{changedPasal > 0 && <>; {changedPasal} pasal ditandai “Diubah oleh” di bawah</>}.
      Teks yang sudah digabung dengan perubahannya belum tersedia di sini.
      {changesHref && <> <a href={changesHref}>{perubahanHref ? "Lihat perubahan pasal demi pasal →" : "Lihat riwayat perubahan →"}</a></>}
    </p>
  </aside>
) : null}

<style>
  .status-banner {
    max-width: var(--measure); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: var(--s-3) var(--s-4); margin-bottom: var(--s-5);
  }
  .status-banner.gone { border-color: var(--gone); }
  .status-banner.changed { border-color: var(--warn); }
  .status-banner p { margin: 0; }
  .status-banner p + p { margin-top: var(--s-1); }
  .head { font-weight: 600; }
  .gone .head { color: var(--text); }
</style>
