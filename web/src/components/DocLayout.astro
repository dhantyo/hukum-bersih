---
// Document page: breadcrumbs, title block, then a side panel (versions, contents, facts) next
// to the main text. Pattern from legislation.gov.uk / Fedlex (see DESIGN.md).
//
// Wide screens: the panel is sticky beside the text and can be hidden (a slim strip with a
// "show" button stays; the choice is remembered as data-panel on <html>, set before first paint
// in layouts/Base.astro). Up to 960px: the panel is a drawer that slides in over the text,
// opened by a button that is always on screen.
interface Crumb { href?: string; label: string }
interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Label of the drawer button on phones and of the panel. */
  panelLabel?: string;
}
const { crumbs, eyebrow, title, subtitle, panelLabel = "Daftar isi" } = Astro.props;
const Chevrons = (dir: "left" | "right") => `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="${dir === "left" ? "M9.5 3.5 5 8l4.5 4.5" : "M6.5 3.5 11 8l-4.5 4.5"}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<nav class="breadcrumbs" aria-label="Lokasi">
  {crumbs.map((c, k) => (
    <>
      {k > 0 && <span aria-hidden="true">›</span>}
      {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
    </>
  ))}
</nav>
<header class="doc-head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <div data-pagefind-ignore><slot name="head" /></div>
</header>
<div class="doc">
  <div class="rail" data-pagefind-ignore data-under-header>
    <button type="button" class="rail-btn" data-panel-show aria-controls="panel" aria-expanded="false">
      <Fragment set:html={Chevrons("right")} /><span class="visually-hidden">Tampilkan panel ({panelLabel.toLowerCase()})</span>
    </button>
  </div>
  <aside class="panel" id="panel" aria-label={panelLabel} data-pagefind-ignore data-under-header>
    <div class="panel-bar">
      <span class="panel-name">{panelLabel}</span>
      <button type="button" class="panel-hide" data-panel-hide aria-controls="panel">
        <Fragment set:html={Chevrons("left")} /><span class="label">Sembunyikan</span>
      </button>
      <button type="button" class="panel-close" data-drawer-close aria-label="Tutup">×</button>
    </div>
    <slot name="panel" />
  </aside>
  <div class="doc-main">
    <slot />
  </div>
</div>
<div class="scrim" data-drawer-close hidden></div>
<button type="button" class="drawer-btn" data-drawer-open aria-controls="panel" aria-expanded="false" data-pagefind-ignore
  aria-label={`Buka ${panelLabel.toLowerCase()}`} title={`${panelLabel}: ketuk atau tarik`}>
  <svg viewBox="0 0 10 16" width="10" height="16" aria-hidden="true"><path d="M3 3.5 7.5 8 3 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<script>
  const root = document.documentElement;
  const panel = document.getElementById("panel");
  const narrow = matchMedia("(max-width: 960px)");
  const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } };

  // wide screens: hide / show, remembered
  const showBtn = document.querySelector<HTMLButtonElement>("[data-panel-show]");
  const syncWide = () => showBtn?.setAttribute("aria-expanded", String(root.dataset.panel !== "hidden"));
  document.querySelector("[data-panel-hide]")?.addEventListener("click", () => {
    root.dataset.panel = "hidden"; set("hb-panel", "hidden"); syncWide(); showBtn?.focus();
  });
  showBtn?.addEventListener("click", () => {
    delete root.dataset.panel; set("hb-panel", "shown"); syncWide();
    panel?.querySelector<HTMLElement>("[data-panel-hide]")?.focus();
  });
  syncWide();

  // up to 960px: a drawer over the text
  const openBtn = document.querySelector<HTMLButtonElement>("[data-drawer-open]");
  const scrim = document.querySelector<HTMLElement>(".scrim");
  const outside = () => [document.querySelector("header.site"), document.querySelector(".doc-main"),
    document.querySelector(".doc-head"), document.querySelector(".breadcrumbs"), document.querySelector("footer.site"), openBtn]
    .filter((e): e is HTMLElement => !!e);
  let returnTo: HTMLElement | null = null;
  const openDrawer = () => {
    if (!panel) return;
    returnTo = document.activeElement as HTMLElement | null;
    root.dataset.drawer = "open";
    openBtn?.setAttribute("aria-expanded", "true");
    if (scrim) scrim.hidden = false;
    outside().forEach((e) => { e.inert = true; });
    // the current chapter in view, then the panel itself
    const here = panel.querySelector<HTMLElement>(".toc a[aria-current]");
    here?.scrollIntoView({ block: "center" });
    (here ?? panel.querySelector<HTMLElement>("[data-drawer-close]"))?.focus({ preventScroll: true });
  };
  const closeDrawer = (restore = true) => {
    if (root.dataset.drawer !== "open") return;
    delete root.dataset.drawer;
    openBtn?.setAttribute("aria-expanded", "false");
    if (scrim) scrim.hidden = true;
    outside().forEach((e) => { e.inert = false; });
    if (restore) returnTo?.focus({ preventScroll: true });
  };
  openBtn?.addEventListener("click", () => { if (!pulled) openDrawer(); pulled = false; });

  // pull: the chevron tab can be dragged right and the drawer follows the finger; the open
  // drawer can be pushed back left. Past a third of its width (or a flick) it opens / closes,
  // otherwise it goes back. Pattern from Sapu Berita's tray (swipe to close).
  let pulled = false;
  const follow = (dx: number, opening: boolean) => {
    if (!panel) return;
    const w = panel.offsetWidth;
    const x = opening ? Math.min(0, dx - w) : Math.min(0, dx);
    panel.style.transition = "none";
    panel.style.visibility = "visible";
    panel.style.transform = `translateX(${x}px)`;
    if (scrim) { scrim.hidden = false; scrim.style.transition = "none"; scrim.style.opacity = String(1 + x / w); }
    return w;
  };
  const release = (dx: number, dt: number, opening: boolean) => {
    if (!panel) return;
    const w = panel.offsetWidth;
    const flick = Math.abs(dx) > 30 && Math.abs(dx) / Math.max(1, dt) > 0.5;
    const open = opening ? dx > w / 3 || (flick && dx > 0) : !(-dx > w / 3 || (flick && dx < 0));
    for (const e of [panel, scrim]) e?.style.removeProperty("transition");
    panel.style.removeProperty("transform"); panel.style.removeProperty("visibility");
    scrim?.style.removeProperty("opacity");
    if (open && root.dataset.drawer !== "open") openDrawer();
    else if (!open) { if (root.dataset.drawer === "open") closeDrawer(); else if (scrim) scrim.hidden = true; }
  };
  const pull = (el: Element | null, opening: boolean) => el?.addEventListener("pointerdown", (ev) => {
    const e = ev as PointerEvent;
    if (!narrow.matches || (e.pointerType === "mouse" && e.button !== 0)) return;
    const x0 = e.clientX, y0 = e.clientY, t0 = performance.now();
    let dx = 0, dragging = false, decided = false;
    const move = (m: PointerEvent) => {
      dx = m.clientX - x0;
      if (!decided) {
        if (Math.abs(dx) < 6 && Math.abs(m.clientY - y0) < 6) return;
        decided = true;
        // horizontal and the right way: a pull; otherwise leave it to scrolling
        dragging = Math.abs(dx) > Math.abs(m.clientY - y0) && (opening ? dx > 0 : dx < 0);
        if (!dragging) return stop();
        (el as HTMLElement).setPointerCapture?.(e.pointerId);
      }
      if (dragging) follow(dx, opening);
    };
    // a pull ends in a click on the tab: that click must not open the drawer again
    const up = () => { stop(); if (dragging) { pulled = opening; setTimeout(() => { pulled = false; }); release(dx, performance.now() - t0, opening); } };
    const stop = () => { removeEventListener("pointermove", move); removeEventListener("pointerup", up); removeEventListener("pointercancel", up); };
    addEventListener("pointermove", move); addEventListener("pointerup", up); addEventListener("pointercancel", up);
  });
  pull(openBtn, true);
  pull(panel, false);
  document.querySelectorAll("[data-drawer-close]").forEach((e) => e.addEventListener("click", () => closeDrawer()));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeDrawer(); });
  // following a link in the drawer (contents, versions) closes it
  panel?.addEventListener("click", (e) => {
    const a = (e.target as Element).closest("a[href]");
    if (a && narrow.matches) closeDrawer(false);
  });
  narrow.addEventListener("change", () => { if (!narrow.matches) closeDrawer(false); });
</script>

<style>
  .doc-head { margin: var(--s-4) 0 var(--s-6); max-width: 52rem; }
  .doc-head h1 { margin-bottom: var(--s-2); }
  .doc-head :global([slot="head"]) { margin-top: var(--s-3); }
  .subtitle { color: var(--text-muted); font-size: var(--fs-lg); margin: 0; }
  .doc { display: grid; grid-template-columns: var(--panel) minmax(0, 1fr); gap: var(--s-7); align-items: start; }
  .doc-main { min-width: 0; }
  .rail { display: none; }

  /* ---------- the panel beside the text (wide screens) ---------- */
  .panel {
    grid-column: 1; grid-row: 1;
    position: sticky; top: calc(var(--s-4) + var(--header-shown, 0px)); max-height: calc(100vh - var(--s-6) - var(--header-shown, 0px)); overflow-y: auto;
    transition: top 0.24s ease-out, max-height 0.24s ease-out;
    font-size: var(--fs-sm); padding-right: var(--s-2);
  }
  .doc-main { grid-column: 2; grid-row: 1; }
  .panel-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-bottom: var(--s-3); }
  .panel-name { display: none; }
  .panel-hide, .rail-btn, .panel-close {
    display: inline-flex; align-items: center; gap: var(--s-1); font: inherit; font-size: var(--fs-xs);
    color: var(--text-muted); background: none; border: 0; cursor: pointer; border-radius: var(--r-sm);
    padding: var(--s-1) var(--s-2) var(--s-1) 0; min-height: var(--s-6);
  }
  .panel-hide:hover, .rail-btn:hover { color: var(--primary); }
  .panel-close { display: none; }

  /* hidden: a slim strip with a "show" button; the text column centres */
  :global(:root[data-panel="hidden"]) .doc { grid-template-columns: var(--tap) minmax(0, 1fr); }
  :global(:root[data-panel="hidden"]) .panel { display: none; }
  :global(:root[data-panel="hidden"]) .rail {
    display: block; grid-column: 1; grid-row: 1; position: sticky; top: calc(var(--s-4) + var(--header-shown, 0px));
    transition: top 0.24s ease-out;
  }
  /* while the header follows the finger, sticky things follow it exactly (Base.astro) */
  @media (min-width: 961px) {
    .panel.tracking, .rail.tracking { transition: none; }
  }
  :global(:root[data-panel="hidden"]) .doc-main { justify-self: center; width: min(100%, var(--measure)); }
  /* comparing versions (CompareMode.astro): the text takes the width. Below 1500px the panel
     folds away to make room for two columns, unless the reader brings it back (data-cmp-panel);
     wider, it stays (with the changes marked in the contents). Keep in step with panelFolds in
     CompareMode.astro. */
  @media (min-width: 961px) {
    :global(:root[data-compare]) .doc-main { justify-self: stretch; width: auto; }
  }
  @media (min-width: 961px) and (max-width: 1499px) {
    :global(:root[data-compare]:not([data-cmp-panel])) .doc { grid-template-columns: var(--tap) minmax(0, 1fr); }
    :global(:root[data-compare]:not([data-cmp-panel])) .panel { display: none; }
    :global(:root[data-compare]:not([data-cmp-panel])) .rail { display: block; grid-column: 1; grid-row: 1; position: sticky; top: calc(var(--s-4) + var(--header-shown, 0px)); }
  }
  .rail-btn {
    width: var(--tap); height: var(--tap); justify-content: center; padding: 0;
    border: 1px solid var(--line-strong); color: var(--text);
  }

  /* ---------- up to 960px: a drawer over the text ---------- */
  .drawer-btn, .scrim { display: none; }
  @media (max-width: 960px) {
    .doc, :global(:root[data-panel="hidden"]) .doc { grid-template-columns: 1fr; gap: 0; }
    .doc-main, :global(:root[data-panel="hidden"]) .doc-main { grid-column: 1; justify-self: stretch; width: auto; }
    .rail, :global(:root[data-panel="hidden"]) .rail { display: none; }
    .panel, :global(:root[data-panel="hidden"]) .panel {
      display: block; position: fixed; z-index: 30; inset: 0 auto 0 0; top: 0;
      width: min(22rem, calc(100vw - var(--s-7))); max-height: none; overflow-y: auto;
      background: var(--bg); border-right: 1px solid var(--line); box-shadow: var(--shadow-pop);
      padding: var(--s-4); padding-left: max(var(--s-4), env(safe-area-inset-left, 0px));
      padding-top: max(var(--s-4), env(safe-area-inset-top, 0px));
      transform: translateX(-105%); visibility: hidden; touch-action: pan-y;
      transition: transform 0.2s ease, visibility 0s linear 0.2s;
    }
    :global(:root[data-drawer="open"]) .panel { transform: none; visibility: visible; transition: transform 0.2s ease; }
    .panel-bar { position: sticky; top: calc(-1 * var(--s-4)); background: var(--bg); padding: var(--s-2) 0; z-index: 1; }
    .panel-name { display: block; font-weight: 600; font-size: var(--fs-base); color: var(--text); }
    .panel-hide { display: none; }
    .panel-close {
      display: inline-flex; justify-content: center; font-size: var(--fs-lg); color: var(--text);
      width: var(--tap); height: var(--tap); padding: 0; border: 1px solid var(--line-strong);
    }
    .scrim:not([hidden]) {
      display: block; position: fixed; inset: 0; z-index: 25; background: var(--scrim);
    }
    /* a slim tab on the left edge: tap it or pull it to the right */
    .drawer-btn {
      display: grid; place-items: center; position: fixed; z-index: 20;
      left: env(safe-area-inset-left, 0px); top: 50%; transform: translateY(-50%);
      width: var(--s-4); height: var(--s-8); padding: 0; cursor: pointer; touch-action: none;
      color: var(--text-muted); background: var(--surface); box-shadow: var(--shadow-sm);
      border: 1px solid var(--line-strong); border-left: 0; border-radius: 0 var(--r-md) var(--r-md) 0;
    }
    /* the visible tab is narrow; the touch target is the full 44px */
    .drawer-btn::before { content: ""; position: absolute; inset: 0 calc(var(--s-4) - var(--tap)) 0 0; }
    .drawer-btn:hover, .drawer-btn:focus-visible { color: var(--primary); }
    :global(:root[data-drawer="open"]) .drawer-btn { visibility: hidden; }
    .scrim { transition: opacity 0.2s ease; }
  }
  @media (max-width: 640px) {
    .doc-head h1 { font-size: var(--fs-xl); }
    .subtitle { font-size: var(--fs-base); }
  }
  @media (prefers-reduced-motion: reduce) { .panel { transition: none !important; } }
  @media print { .drawer-btn, .scrim, .rail, .panel { display: none !important; } }
</style>
