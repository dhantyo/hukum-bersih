---
// Document page: breadcrumbs, title block, then a side panel (facts, versions, contents) next
// to the main text. Pattern from legislation.gov.uk / Fedlex (see DESIGN.md).
interface Crumb { href?: string; label: string }
interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Label of the folded side panel on phones. */
  panelLabel?: string;
}
const { crumbs, eyebrow, title, subtitle, panelLabel = "Keterangan dan daftar isi" } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Lokasi">
  {crumbs.map((c, k) => (
    <>
      {k > 0 && <span aria-hidden="true">›</span>}
      {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
    </>
  ))}
</nav>
<header class="doc-head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <div data-pagefind-ignore><slot name="head" /></div>
</header>
<div class="doc">
  <aside class="panel" aria-label="Keterangan" data-pagefind-ignore>
    <details class="panel-fold" open>
      <summary>{panelLabel}</summary>
      <slot name="panel" />
    </details>
  </aside>
  <div class="doc-main">
    <slot />
  </div>
</div>
<a class="to-toc" href="#daftar-isi" hidden data-pagefind-ignore>Daftar isi ↑</a>

<script>
  // the side panel folds away on phones so the text comes first (DESIGN.md)
  const narrow = matchMedia("(max-width: 960px)");
  const sync = () => document.querySelectorAll<HTMLDetailsElement>(".panel-fold").forEach((d) => { d.open = !narrow.matches; });
  sync();
  narrow.addEventListener("change", sync);

  // Long laws on phones: once the contents are scrolled away, a button brings them back
  // (GOV.UK "back to top" pattern). On wide screens the side panel is sticky instead.
  const toc = document.getElementById("daftar-isi");
  const btn = document.querySelector<HTMLAnchorElement>(".to-toc");
  const panel = document.querySelector(".panel");
  if (toc && btn && panel) {
    new IntersectionObserver(([e]) => {
      btn.hidden = e.isIntersecting || e.boundingClientRect.top > 0;
    }).observe(panel);
    btn.addEventListener("click", (ev) => {
      ev.preventDefault();
      const fold = toc.closest("details");
      if (fold) fold.open = true;
      toc.scrollIntoView();
      toc.querySelector<HTMLAnchorElement>("a[aria-current]")?.scrollIntoView({ block: "nearest" });
      toc.querySelector<HTMLAnchorElement>("a[aria-current], a")?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .panel-fold > summary { display: none; }
  .doc-head { margin: var(--s-4) 0 var(--s-6); max-width: 52rem; }
  .doc-head h1 { margin-bottom: var(--s-2); }
  .doc-head :global([slot="head"]) { margin-top: var(--s-3); }
  .subtitle { color: var(--text-muted); font-size: var(--fs-lg); margin: 0; }
  .doc { display: grid; grid-template-columns: var(--panel) minmax(0, 1fr); gap: var(--s-7); align-items: start; }
  .panel {
    position: sticky; top: var(--s-4); max-height: calc(100vh - var(--s-6)); overflow-y: auto;
    font-size: var(--fs-sm); padding-right: var(--s-2);
  }
  .doc-main { min-width: 0; }
  .to-toc {
    position: fixed; right: var(--s-4); bottom: var(--s-4); z-index: 5;
    background: var(--primary); color: var(--bg); text-decoration: none; font-weight: 600; font-size: var(--fs-sm);
    padding: var(--s-3) var(--s-4); border-radius: 999px; box-shadow: var(--shadow-pop);
  }
  .to-toc[hidden] { display: none; }
  @media (min-width: 961px) { .to-toc { display: none; } }
  @media print { .to-toc { display: none; } }
  @media (max-width: 960px) {
    .doc { grid-template-columns: 1fr; gap: var(--s-5); }
    .panel { position: static; max-height: none; overflow: visible; padding: 0; }
    .panel-fold { border: 1px solid var(--line); border-radius: var(--r-md); padding: var(--s-3) var(--s-4); }
    .panel-fold > summary { display: list-item; cursor: pointer; font-weight: 600; padding: var(--s-2) 0; }
    .panel-fold[open] > summary { margin-bottom: var(--s-4); }
  }
  @media (max-width: 640px) {
    .doc-head h1 { font-size: var(--fs-xl); }
    .subtitle { font-size: var(--fs-base); }
  }
</style>
