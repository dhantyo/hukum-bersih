---
// Renders a parsed law/draft text (lib/lawdoc.ts) with stable anchors.
import type { LawDoc } from "../lib/lawdoc.ts";

interface Props { doc: LawDoc }
const { doc } = Astro.props;
---
<article class="law">
  {doc.nodes.map((n) => {
    switch (n.kind) {
      case "title": return <p class="law-title">{n.label}</p>;
      case "bab": return <h2 id={n.anchor}>{n.label}<span class="sub">{n.title}</span></h2>;
      case "bagian": return <h3 class="bagian">{n.label}<span class="sub">{n.title}</span></h3>;
      case "paragraf": return <h3 class="paragraf">{n.label}<span class="sub">{n.title}</span></h3>;
      case "pasal": return <h3 class="pasal" id={n.anchor}><a href={`#${n.anchor}`}>{n.label}</a></h3>;
      case "penjelasan": return <h2 id={n.anchor} class="penjelasan">Penjelasan</h2>;
      case "umum": return <h3 id={n.anchor}>Umum</h3>;
      case "pasal-demi-pasal": return <h3 id={n.anchor}>Pasal demi Pasal</h3>;
      case "p-pasal": return <h3 class="pasal" id={n.anchor}><a href={`#${n.anchor}`}>{n.label}</a></h3>;
      default: return <p class={`l i${n.indent}`}>{n.label}</p>;
    }
  })}
</article>

<style>
  .law-title { font-weight: 700; text-align: center; margin: 1.5rem 0; }
  h2 { text-align: center; }
  h2 .sub, h3 .sub { display: block; font-weight: 600; font-size: 0.95em; }
  h3.bagian, h3.paragraf { text-align: center; }
  h3.pasal { text-align: center; margin-top: 2rem; }
  h3.pasal a { color: inherit; text-decoration: none; }
  h3.pasal a:hover { text-decoration: underline; }
  h2.penjelasan { margin-top: 4rem; padding-top: 2rem; border-top: 2px solid var(--line); }
  p.l { margin: 0.35rem 0; }
  p.i1 { margin-left: 1.5rem; }
  p.i2 { margin-left: 3rem; }
  p.i3 { margin-left: 4.5rem; }
  @media (max-width: 480px) {
    p.i1 { margin-left: 0.9rem; }
    p.i2 { margin-left: 1.8rem; }
    p.i3 { margin-left: 2.7rem; }
  }
</style>
