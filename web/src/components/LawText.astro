---
// A law or draft rendered from Akoma Ntoso (lib/lawdoc.ts).
import AknNode, { type PasalNote } from "./AknNode.astro";
import type { LawDoc } from "../lib/lawdoc.ts";

interface Props { doc: LawDoc; notes?: Map<string, PasalNote[]> }
const { doc, notes } = Astro.props;
---
<article class="law">
  <div class="akn-preface">{doc.preface.map((n) => <AknNode node={n} />)}</div>
  <div class="akn-preamble">{doc.preamble.map((n) => <AknNode node={n} />)}</div>
  <div class="akn-body">{doc.body.map((n) => <AknNode node={n} notes={notes} />)}</div>
  {doc.conclusions.length > 0 && <div class="akn-conclusions">{doc.conclusions.map((n) => <AknNode node={n} />)}</div>}
  {doc.penjelasan.length > 0 && (
    <section class="penjelasan" id="penjelasan">
      <h2 class="penjelasan-title">Penjelasan</h2>
      {doc.penjelasan.map((n) => <AknNode node={n} penjelasan />)}
    </section>
  )}
</article>

<style>
  /* Legal text: serif, readable measure, hanging numbers (DESIGN.md) */
  .law { font-family: var(--font-law); font-size: var(--fs-law); line-height: 1.65; max-width: var(--measure); }
  .law :global(.akn-preface .akn-p) { font-family: var(--font-ui); font-weight: 600; text-align: center; font-size: var(--fs-base); letter-spacing: 0.02em; margin: 0 0 var(--s-5); }
  .law :global(.akn-preamble) { margin-bottom: var(--s-6); }
  .law :global(h2) {
    font-family: var(--font-ui); text-align: center; font-size: var(--fs-sm); font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; margin: var(--s-7) 0 var(--s-4);
  }
  .law :global(h2 .sub) { display: block; font-size: var(--fs-base); letter-spacing: 0.02em; margin-top: var(--s-1); }
  .law :global(.akn-article) { scroll-margin-top: var(--s-4); }
  .law :global(.akn-article h3) {
    font-family: var(--font-ui); text-align: center; margin: var(--s-6) 0 var(--s-3);
    font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0.04em;
  }
  .law :global(.akn-article h3 a) { color: inherit; text-decoration: none; }
  .law :global(.akn-article h3 a:hover) { color: var(--primary); text-decoration: underline; }
  .law :global(.akn-p) { margin: 0 0 var(--s-2); }
  .law :global(.akn-note) {
    font-family: var(--font-ui); font-size: var(--fs-sm); text-align: center; color: var(--warn);
    margin: calc(-1 * var(--s-2)) 0 var(--s-3);
  }
  .law :global(.numbered) { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); column-gap: var(--s-1); }
  .law :global(.akn-num) { font-variant-numeric: tabular-nums; }
  .law :global(.akn-conclusions) { margin-top: var(--s-7); color: var(--text-muted); font-size: var(--fs-base); }
  .penjelasan { margin-top: var(--s-8); padding-top: var(--s-6); border-top: 2px solid var(--line); }
  .penjelasan-title { text-align: center; font-family: var(--font-ui); }
  .law :global(.penjelasan .numbered) { grid-template-columns: 5.5rem minmax(0, 1fr); }
  .law :global(:target) { background: var(--primary-bg); border-radius: var(--r-sm); box-shadow: 0 0 0 6px var(--primary-bg); }
  @media (max-width: 640px) {
    .law { font-size: var(--fs-base); }
    .law :global(.numbered) { grid-template-columns: 1.9rem minmax(0, 1fr); }
    .law :global(.penjelasan .numbered) { grid-template-columns: 1fr; }
  }
</style>
