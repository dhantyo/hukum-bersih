---
import { tanggal } from "../lib/labels.ts";
import { citeId, lawPath, rel, shortCite, STATUS_LABEL, type Regulation } from "../lib/peraturan.ts";

interface Props { laws: Regulation[] }
const { laws } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<ul class="rows">
  {laws.map((r) => (
    <li>
      <a class="row-title" href={`${base}${lawPath(r)}`}>{r.subject || r.title}</a>
      <div class="row-meta">
        {shortCite(r)}
        {r.status && <> · <span class={`badge ${r.status}`}>{STATUS_LABEL[r.status] ?? r.status}</span></>}
        {r.tanggal_penetapan && <> · ditetapkan {tanggal(r.tanggal_penetapan)}</>}
        {rel(r).amended_by.length > 0 && <> · <span class="badge diubah">diubah {rel(r).amended_by.length}×</span></>}
        {rel(r).amends.length > 0 && <> · mengubah {rel(r).amends.map((a) => citeId(a.id)).join(", ")}</>}
        {!r.versions.some((v) => v.text) && <> · <span class="badge none">teks belum tersedia</span></>}
      </div>
    </li>
  ))}
</ul>
