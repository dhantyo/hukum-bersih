---
// Table of contents from an Akoma Ntoso body: BAB with title and pasal range; the BAB being
// read opens to a compact grid of its pasal (laws without BAB: the grid of all pasal), plus a
// "Ke pasal" field. Always in Modern labels (navigation, not the law text). The current BAB and
// pasal are highlighted by the script below.
import type { AknNode, LawDoc } from "../lib/lawdoc.ts";
import { modernHeading, pasalKey } from "../lib/display.ts";

interface Props { doc: LawDoc }
const { doc } = Astro.props;

const articles = (n: AknNode): AknNode[] =>
  n.tag === "article" ? [n] : n.children.flatMap(articles);
// the same short anchors as LawText.astro: the first pasal with a number gets #pasal-<n>
const alias = new Map<string, string>();
const taken = new Set<string>();
const walk = (n: AknNode) => {
  if (n.tag === "article" && n.num && n.eId) {
    const a = `pasal-${pasalKey(n.num)}`;
    if (!taken.has(a)) { taken.add(a); alias.set(n.eId, a); }
  }
  n.children.forEach(walk);
};
doc.body.forEach(walk);
const href = (a: AknNode) => `#${(a.eId && alias.get(a.eId)) ?? a.eId}`;
const chapters = doc.body.filter((n) => n.tag === "chapter");
const loose = chapters.length ? [] : doc.body.flatMap(articles);
const range = (arts: AknNode[]) =>
  arts.length === 0 ? "" : arts.length === 1 ? `Pasal ${arts[0].num}` : `Pasal ${arts[0].num}–${arts.at(-1)!.num}`;
const hasPasal = taken.size > 0;
---
<nav class="toc" id="daftar-isi" aria-label="Daftar isi">
  <div class="toc-head">
    <h2 class="panel-title">Daftar isi</h2>
    <span class="toc-folds">
      <button type="button" data-fold="false">Tutup semua</button>
      <button type="button" data-fold="true">Buka semua</button>
    </span>
  </div>
  {hasPasal && (
    <form class="toc-jump" data-toc-jump>
      <label for="toc-jump-input">Ke pasal</label>
      <input id="toc-jump-input" type="text" inputmode="text" autocomplete="off" placeholder="mis. 27" size="5" />
      <span class="toc-jump-msg" role="status"></span>
    </form>
  )}
  <ol class="toc-list">
    {chapters.map((c) => {
      const arts = articles(c);
      return (
        <li class="toc-ch" data-ch={c.eId}>
          <a href={`#${c.eId}`} class="toc-ch-link">
            <span class="toc-label">Bab {c.num}</span>{" "}
            {c.heading && <><span class="toc-title">{modernHeading(c.heading)}</span>{" "}</>}
            {range(arts) && <span class="toc-range">{range(arts)}</span>}
          </a>
          {arts.length > 0 && (
            <ol class="toc-pasal" aria-label={`Pasal dalam Bab ${c.num}`}>
              {arts.map((a) => <li><a href={href(a)} data-pasal={a.eId}>{a.num}</a></li>)}
            </ol>
          )}
        </li>
      );
    })}
    {loose.length > 0 && (
      <li class="toc-ch open">
        <ol class="toc-pasal" aria-label="Pasal">
          {loose.map((a) => <li><a href={href(a)} data-pasal={a.eId}>{a.num}</a></li>)}
        </ol>
      </li>
    )}
    {doc.penjelasan.length > 0 && <li class="toc-pj"><a href="#penjelasan" class="toc-ch-link"><span class="toc-label">Penjelasan</span></a></li>}
  </ol>
</nav>

<script>
  // fold or unfold every BAB and Pasal (handled in LawText.astro)
  document.querySelectorAll<HTMLButtonElement>(".toc [data-fold]").forEach((b) => b.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("hb:fold", { detail: b.dataset.fold === "true" }));
  }));

  // "Ke pasal": jump to #pasal-<n> (LawText.astro opens the folded blocks around it)
  const jump = document.querySelector<HTMLFormElement>("[data-toc-jump]");
  jump?.addEventListener("submit", (e) => {
    e.preventDefault();
    const input = jump.querySelector("input")!;
    const msg = jump.querySelector(".toc-jump-msg")!;
    const key = input.value.trim().toLowerCase().replace(/^pasal\s*/, "").replace(/[^0-9a-z]+/g, "");
    if (!key) return;
    if (document.getElementById(`pasal-${key}`)) {
      msg.textContent = "";
      location.hash = `pasal-${key}`;
    } else {
      msg.textContent = `Pasal ${input.value.trim()} tidak ada`;
    }
  });

  // the BAB in view: highlighted, and its pasal grid open; the pasal in view: highlighted
  const toc = document.querySelector<HTMLElement>(".toc");
  const chLinks = new Map<string, HTMLAnchorElement>();
  toc?.querySelectorAll<HTMLAnchorElement>(".toc-ch-link").forEach((a) => chLinks.set(a.hash.slice(1), a));
  const pasalLinks = new Map<string, HTMLAnchorElement>();
  toc?.querySelectorAll<HTMLAnchorElement>("[data-pasal]").forEach((a) => pasalLinks.set(a.dataset.pasal!, a));
  const keepVisible = (link: HTMLElement) => {
    const pane = link.closest<HTMLElement>(".panel");
    if (!pane || getComputedStyle(pane).position !== "sticky" || pane.scrollHeight <= pane.clientHeight) return;
    const l = link.getBoundingClientRect(), p = pane.getBoundingClientRect();
    if (l.top < p.top || l.bottom > p.bottom) pane.scrollTop += l.top - p.top - p.height / 3;
  };
  const obs = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const id = (e.target as HTMLElement).id;
      const ch = chLinks.get(id);
      if (ch) {
        chLinks.forEach((a) => { a.removeAttribute("aria-current"); a.parentElement?.classList.remove("open"); });
        ch.setAttribute("aria-current", "true");
        ch.parentElement?.classList.add("open");
        keepVisible(ch);
      }
      const p = pasalLinks.get(id);
      if (p) {
        pasalLinks.forEach((a) => a.removeAttribute("aria-current"));
        p.setAttribute("aria-current", "true");
        const li = p.closest<HTMLElement>(".toc-ch");
        if (li && !li.classList.contains("open")) {
          toc?.querySelectorAll(".toc-ch.open").forEach((x) => x.classList.remove("open"));
          li.classList.add("open");
        }
        keepVisible(p);
      }
    }
  }, { rootMargin: "0px 0px -70% 0px" });
  [...chLinks.keys(), ...pasalLinks.keys()].forEach((id) => { const el = document.getElementById(id); if (el) obs.observe(el); });
</script>

<style>
  .toc-list { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .toc-ch-link {
    display: block; padding: var(--s-1) var(--s-3); margin-left: -1px; color: var(--text);
    text-decoration: none; border-left: 2px solid transparent; line-height: 1.35;
  }
  .toc-ch-link:hover { background: var(--bg-subtle); }
  .toc-ch-link[aria-current] { border-left-color: var(--primary); color: var(--primary); }
  .toc-label { display: block; font-weight: 600; font-size: var(--fs-xs); letter-spacing: 0.03em; }
  .toc-title { display: block; }
  .toc-range { display: block; font-size: var(--fs-xs); color: var(--text-muted); }

  /* the pasal of the BAB being read, as a compact grid of numbers */
  .toc-pasal { display: none; list-style: none; margin: var(--s-1) 0 var(--s-2) var(--s-3); padding: 0; flex-wrap: wrap; gap: var(--s-1); }
  .toc-ch.open > .toc-pasal { display: flex; }
  .toc-pasal a {
    display: grid; place-items: center; min-width: 2.25rem; padding: 0 var(--s-1); min-height: var(--s-6);
    font-size: var(--fs-xs); font-variant-numeric: tabular-nums; color: var(--text); text-decoration: none;
    border-radius: var(--r-sm);
  }
  .toc-pasal a:hover { background: var(--bg-subtle); color: var(--primary); }
  .toc-pasal a[aria-current] { background: var(--primary-bg); color: var(--primary); font-weight: 600; }

  .toc-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2); margin-bottom: var(--s-2); }
  .toc-head .panel-title { margin: 0; }
  .toc-folds { display: flex; gap: var(--s-3); }
  .toc-folds button {
    font: inherit; font-size: var(--fs-xs); color: var(--primary); background: none; border: 0; padding: 0;
    cursor: pointer; text-decoration: underline; text-underline-offset: 0.15em; text-decoration-thickness: 1px;
  }
  .toc-folds button:hover { text-decoration-thickness: 2px; }
  .toc-jump { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-2); margin: 0 0 var(--s-3); font-size: var(--fs-xs); color: var(--text-muted); }
  .toc-jump input {
    width: 5rem; font: inherit; font-size: var(--fs-sm); color: var(--text); background: var(--bg);
    border: 1px solid var(--line-strong); border-radius: var(--r-sm); padding: var(--s-1) var(--s-2);
  }
  .toc-jump-msg:empty { display: none; }
  .toc-jump-msg { flex-basis: 100%; color: var(--warn); }
  :global(:root[data-penjelasan="sembunyi"]) .toc-pj { display: none; }
  @media (pointer: coarse) {
    .toc-folds button { min-height: var(--tap); }
    .toc-pasal a { min-width: var(--tap); min-height: var(--tap); }
    .toc-ch-link { padding-top: var(--s-3); padding-bottom: var(--s-3); }
  }
</style>
