---
// Recursive renderer for an Akoma Ntoso subtree (lib/lawdoc.ts). Element names become
// "akn-<name>" classes and eIds become ids, following Laws.Africa's HTML convention so that
// their law-widgets can be used on top later.
//
// Reader view (DESIGN.md "Law text"): headings are rendered twice, as printed (.f-asli) and in
// normal capitals (.f-modern); CSS shows one. BAB, Bagian, Paragraf and Pasal headings are
// buttons that fold their content (script in LawText.astro). Penjelasan entries carry the
// pasal they explain (data-pj-for) so the reader can show them under that pasal.
import type { AknNode } from "../lib/lawdoc.ts";
import { cukupJelas, modernHeading, modernLabel, pasalKey, preview } from "../lib/display.ts";

export interface PasalNote { label: string; href?: string }
interface Props { node: AknNode; penjelasan?: boolean; notes?: Map<string, PasalNote[]>; aliases?: Map<string, string> }
const { node, penjelasan = false, notes, aliases } = Astro.props;
const alias = !penjelasan && node.eId ? aliases?.get(node.eId) : undefined;
const note = node.tag === "article" && !penjelasan && node.num ? notes?.get(node.num) : undefined;
const LABEL: Record<string, [string, string]> = {
  chapter: ["BAB", "Bab"], part: ["Bagian", "Bagian"], subpart: ["Paragraf", "Paragraf"], article: ["Pasal", "Pasal"],
};
const isHeadingBlock = ["chapter", "part", "subpart"].includes(node.tag);
const [asliWord, modernWord] = LABEL[node.tag] ?? ["", ""];
const label = node.num && asliWord ? `${asliWord} ${node.num}` : node.num;
const modernNum = node.num && modernWord ? `${modernWord} ${node.num}` : node.num;
const id = node.eId ? (penjelasan ? `penjelasan-${node.eId}` : node.eId) : undefined;
const cid = id ? `${id}-c` : undefined;
const kids = node.children;
const pjPdp = penjelasan && node.tag === "part" && /pasal\s+demi\s+pasal/i.test(node.heading ?? "");
const pjTitle = penjelasan && node.tag === "part" && !node.num && /^penjelasan$/i.test(node.heading ?? "");
const cj = penjelasan && node.tag !== "p" && cukupJelas(node);
const Chevron = `<svg class="chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
{node.tag === "p" ? (
  <p class="akn-p" id={id}>{node.text}</p>
) : node.tag === "article" && !penjelasan ? (
  <section class="akn-article fold" id={id}>
    {alias && <span class="alias" id={alias}></span>}
    <h3 class="fold-h" id={id ? `${id}-h` : undefined}>
      <button type="button" class="fold-btn" aria-expanded="true" aria-controls={cid}><Fragment set:html={Chevron} />{label}</button>
      <span class="fold-preview" aria-hidden="true" data-pagefind-ignore>{preview(node)}</span>
      <a class="perma" href={`#${alias ?? id}`} aria-label={`Tautan ke ${label}`} data-pagefind-ignore>#</a>
    </h3>
    {note && (
      <p class="akn-note">Diubah oleh {note.map((n, i) => <>{i > 0 && (i === note.length - 1 ? " dan " : ", ")}{n.href ? <a href={n.href}>{n.label}</a> : n.label}</>)}</p>
    )}
    <div class="fold-c" id={cid}>
      {kids.map((c) => <Astro.self node={c} notes={notes} aliases={aliases} />)}
    </div>
  </section>
) : node.tag === "article" ? (
  <section class:list={["akn-article", "pj-entry", { cj }]} id={id} data-pj-for={node.num ? pasalKey(node.num) : undefined}>
    <h3 id={id ? `${id}-h` : undefined}>
      <span class="pj-pasal">{node.num ? <a href={`#pasal-${pasalKey(node.num)}`}>{label}</a> : label}</span>
      <span class="pj-inline-label">Penjelasan</span>
    </h3>
    {kids.map((c) => <Astro.self node={c} penjelasan />)}
  </section>
) : isHeadingBlock && !penjelasan ? (
  <section class={`akn-${node.tag} fold`} id={id}>
    <h2 class="fold-h">
      <button type="button" class="fold-btn" aria-expanded="true" aria-controls={cid}>
        <Fragment set:html={Chevron} />
        <span class="hnum"><span class="f-asli">{label}</span><span class="f-modern" data-pagefind-ignore>{modernNum}</span></span>{node.heading && <>{" "}<span class="sub"><span class="f-asli">{node.heading}</span><span class="f-modern" data-pagefind-ignore>{modernHeading(node.heading)}</span></span></>}
      </button>
    </h2>
    <div class="fold-c" id={cid}>
      {kids.map((c) => <Astro.self node={c} notes={notes} aliases={aliases} />)}
    </div>
  </section>
) : isHeadingBlock ? (
  <section class:list={[`akn-${node.tag}`, { "pj-pdp": pjPdp, "pj-title": pjTitle }]} id={id}>
    {!pjTitle && (
      <h2>{node.tag === "part" ? node.num : label}{node.heading && <>{" "}<span class="sub"><span class="f-asli">{node.heading}</span><span class="f-modern" data-pagefind-ignore>{modernHeading(node.heading)}</span></span></>}</h2>
    )}
    {kids.map((c) => <Astro.self node={c} penjelasan />)}
  </section>
) : node.num ? (
  <div class:list={[`akn-${node.tag}`, "numbered", { cj }]} id={id}>
    {penjelasan && modernLabel(node.num) !== node.num ? (
      <span class="akn-num"><span class="f-asli">{node.num}</span><span class="f-modern" data-pagefind-ignore>{modernLabel(node.num)}</span></span>
    ) : (
      <span class="akn-num">{node.num}</span>
    )}
    <div class="akn-body">{kids.map((c) => <Astro.self node={c} penjelasan={penjelasan} notes={notes} aliases={aliases} />)}</div>
  </div>
) : (
  <div class={`akn-${node.tag}`} id={id}>
    {kids.map((c) => <Astro.self node={c} penjelasan={penjelasan} notes={notes} aliases={aliases} />)}
  </div>
)}
