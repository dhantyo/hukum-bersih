---
// "Aa": the reader picks the font and size of law text. Stored in this browser only
// (localStorage) and applied before first paint by the inline script in layouts/Base.astro.
const fonts = [
  { key: "serif", label: "Source Serif", note: "serif, bawaan" },
  { key: "literata", label: "Literata", note: "serif buku" },
  { key: "sans", label: "Public Sans", note: "tanpa kait" },
  { key: "atkinson", label: "Atkinson Hyperlegible", note: "paling mudah dibaca" },
];
const sizes = [{ key: "normal", label: "Normal" }, { key: "large", label: "Besar" }];
---
<details class="reading">
  <summary aria-label="Tampilan teks: huruf dan ukuran"><span aria-hidden="true">Aa</span></summary>
  <div class="pop" role="group" aria-label="Tampilan teks">
    <fieldset>
      <legend>Huruf teks peraturan</legend>
      {fonts.map((f) => (
        <label class="opt">
          <input type="radio" name="hb-font" value={f.key} checked={f.key === "serif"} />
          <span class="sample" data-font-sample={f.key}>{f.label}</span>
          <span class="note">{f.note}</span>
        </label>
      ))}
    </fieldset>
    <fieldset>
      <legend>Ukuran</legend>
      <div class="sizes">
        {sizes.map((s) => (
          <label class="chip"><input type="radio" name="hb-size" value={s.key} checked={s.key === "normal"} /> {s.label}</label>
        ))}
      </div>
    </fieldset>
    <p class="preview">Setiap Orang berhak atas pengakuan, jaminan, perlindungan, dan kepastian hukum yang adil.</p>
  </div>
</details>

<script>
  const root = document.documentElement;
  const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } };
  for (const [name, attr, def] of [["hb-font", "font", "serif"], ["hb-size", "size", "normal"]] as const) {
    const current = get(name) ?? def;
    document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((input) => {
      input.checked = input.value === current;
      input.addEventListener("change", () => {
        set(name, input.value);
        if (input.value === def) delete root.dataset[attr];
        else root.dataset[attr] = input.value;
      });
    });
  }
  // close when clicking elsewhere or pressing Escape
  const box = document.querySelector<HTMLDetailsElement>("details.reading");
  document.addEventListener("click", (e) => { if (box?.open && !box.contains(e.target as Node)) box.open = false; });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && box?.open) { box.open = false; box.querySelector("summary")?.focus(); } });
</script>

<style>
  .reading { position: relative; }
  summary {
    list-style: none; cursor: pointer; display: grid; place-items: center;
    min-width: 2.75rem; min-height: 2.75rem; border: 1px solid var(--line); border-radius: var(--r-sm);
    font-family: var(--font-law); font-weight: 600; font-size: var(--fs-base); color: var(--text);
    background: var(--bg);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .reading[open] summary { background: var(--bg-subtle); }
  .pop {
    position: absolute; right: 0; top: calc(100% + var(--s-2)); z-index: 20; width: min(19rem, calc(100vw - 2 * var(--s-4)));
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md);
    box-shadow: var(--shadow-pop); padding: var(--s-4);
  }
  fieldset { border: 0; margin: 0 0 var(--s-4); padding: 0; }
  legend { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: var(--s-2); }
  .opt { display: grid; grid-template-columns: auto 1fr; column-gap: var(--s-2); align-items: baseline; padding: var(--s-2); border-radius: var(--r-sm); cursor: pointer; }
  .opt:hover { background: var(--bg-subtle); }
  .opt:has(input:checked) { background: var(--primary-bg); }
  .opt .note { grid-column: 2; font-size: var(--fs-xs); color: var(--text-muted); }
  .sample { font-size: var(--fs-base); }
  [data-font-sample="serif"] { font-family: var(--font-source-serif); }
  [data-font-sample="literata"] { font-family: var(--font-literata); }
  [data-font-sample="sans"] { font-family: var(--font-ui); }
  [data-font-sample="atkinson"] { font-family: var(--font-atkinson); }
  .sizes { display: flex; gap: var(--s-2); }
  .chip { display: flex; gap: var(--s-1); align-items: center; padding: var(--s-1) var(--s-3); border: 1px solid var(--line); border-radius: 999px; cursor: pointer; font-size: var(--fs-sm); }
  .chip:has(input:checked) { border-color: var(--primary); background: var(--primary-bg); }
  .preview { margin: 0; padding-top: var(--s-3); border-top: 1px solid var(--line); font-family: var(--font-law); font-size: var(--fs-law); line-height: 1.6; }
</style>
